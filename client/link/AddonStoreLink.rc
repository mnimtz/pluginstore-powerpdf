// Version and icon of the addonstore:// link helper. Browsers show the
// FileDescription when they ask whether to open the link. The helper has
// its own version: bump it whenever AddonStoreLink.cpp changes.
#include <winres.h>

IDI_ICON1 ICON "AddonStoreLink.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Tungsten Automation"
            VALUE "FileDescription", "Add-on Store"
            VALUE "FileVersion", "1.0.0"
            VALUE "InternalName", "AddonStoreLink"
            VALUE "OriginalFilename", "AddonStoreLink.exe"
            VALUE "ProductName", "Add-on Store for Tungsten Power PDF"
            VALUE "ProductVersion", "1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
