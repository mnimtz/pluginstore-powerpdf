    IDS_PSO_HINT        "Beta plugins passed the automatic checks but are not yet reviewed by an admin. Install them at your own risk."
    IDS_PSO_VERBOSE     "Verbose logging (%TEMP%\\PluginStore.log)"
    IDS_PSO_GRP_DIAG    "Diagnostics"
END

