// Strings — French
LANGUAGE LANG_FRENCH, SUBLANG_FRENCH
STRINGTABLE
BEGIN
    IDS_PS_TITLE        "Add-on Store"
    IDS_PS_TAB_TITLE    "Fonctions avancées"
    IDS_PS_GROUP        "Add-on Store"
    IDS_PS_BTN_OPEN     "Add-on Store"
    IDS_PS_TIP_OPEN     "Parcourir et installer des plug-ins pour Power PDF"
    IDS_PSD_TITLE       "Add-on Store"
    IDS_PSD_C_NAME      "Plug-in"
    IDS_PSD_C_AVAIL     "Disponible"
