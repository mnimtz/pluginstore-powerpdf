// PluginStore.rc — Plugin-Store client resource script.
// UTF-8 with code_page pragma. String ids live in Resource.h; every IDS_
// exists in every language block below (English is the runtime fallback).
#pragma code_page(65001)
#include "resource.h"
#include "afxres.h"

/////////////////////////////////////////////////////////////////////////////
// Version
VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,3,3,0
 PRODUCTVERSION 0,3,3,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x2L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Tungsten Automation"
            VALUE "FileDescription", "Plugin-Store client for Tungsten Power PDF"
            VALUE "FileVersion", "0.3.3"
            VALUE "InternalName", "PluginStore"
            VALUE "OriginalFilename", "PluginStore.zxt"
            VALUE "ProductName", "PluginStore-PowerPDF"
            VALUE "ProductVersion", "0.3.3"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

/////////////////////////////////////////////////////////////////////////////
// Bitmaps
IDB_STORE     BITMAP  "icon_store32.bmp"
IDB_STORE16   BITMAP  "icon_store16.bmp"

/////////////////////////////////////////////////////////////////////////////
// Store dialog
IDD_PS_DIALOG DIALOGEX 0, 0, 560, 260
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Plugin-Store"
FONT 9, "Segoe UI", 400, 0, 0x0
BEGIN
    CONTROL         "", IDC_PS_LIST, "SysListView32",
                    LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP,
                    7, 7, 546, 140
    EDITTEXT        IDC_PS_DESC, 7, 152, 546, 44,
                    ES_MULTILINE | ES_READONLY | WS_VSCROLL | NOT WS_TABSTOP
    LTEXT           "", IDC_PS_ADMIN_NOTE, 7, 201, 546, 10
    LTEXT           "", IDC_PS_STATUS, 7, 214, 546, 18
    PUSHBUTTON      "Update Plugin-Store", IDC_PS_SELFUPDATE, 7, 239, 110, 14
    PUSHBUTTON      "Refresh", IDC_PS_REFRESH, 273, 239, 60, 14
    PUSHBUTTON      "Uninstall", IDC_PS_UNINSTALL, 337, 239, 72, 14
    DEFPUSHBUTTON   "Install", IDC_PS_INSTALL, 413, 239, 70, 14
    PUSHBUTTON      "Close", IDCANCEL, 487, 239, 66, 14
END

/////////////////////////////////////////////////////////////////////////////
// Options page (File > Options > Plugin-Store)
IDD_PS_OPTIONS DIALOGEX 0, 0, 320, 180
STYLE DS_SETFONT | WS_CHILD
FONT 9, "Segoe UI", 400, 0, 0x0
BEGIN
    GROUPBOX        "", IDC_PSO_GRP, 4, 4, 312, 92
    LTEXT           "", IDC_PSO_URL_LBL, 12, 18, 296, 10
    EDITTEXT        IDC_PSO_URL, 12, 30, 296, 13, ES_AUTOHSCROLL
    CONTROL         "", IDC_PSO_BETA, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 12, 50, 296, 10
    LTEXT           "", IDC_PSO_HINT, 12, 64, 296, 26
    GROUPBOX        "", IDC_PSO_GRP_DIAG, 4, 100, 312, 32
    CONTROL         "", IDC_PSO_VERBOSE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 12, 113, 296, 10
    LTEXT           "", IDC_PSO_VERSION, 4, 140, 312, 10
END

