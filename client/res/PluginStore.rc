// PluginStore.rc — Add-on Store client resource script.
// UTF-8 with code_page pragma. String ids live in Resource.h; every IDS_
// exists in every language block below (English is the runtime fallback).
#pragma code_page(65001)
#include "resource.h"
#include "afxres.h"

/////////////////////////////////////////////////////////////////////////////
// Version
VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,7,0,0
 PRODUCTVERSION 0,7,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x2L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Tungsten Automation"
            VALUE "FileDescription", "Add-on Store client for Tungsten Power PDF"
            VALUE "FileVersion", "0.7.0"
            VALUE "InternalName", "PluginStore"
            VALUE "OriginalFilename", "PluginStore.zxt"
            VALUE "ProductName", "Add-on Store for Tungsten Power PDF"
            VALUE "ProductVersion", "0.7.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

/////////////////////////////////////////////////////////////////////////////
// Bitmaps
IDB_STORE     BITMAP  "icon_store32.bmp"
IDB_STORE16   BITMAP  "icon_store16.bmp"
IDB_STORE_UPD   BITMAP  "icon_store32_upd.bmp"
IDB_STORE16_UPD BITMAP  "icon_store16_upd.bmp"

/////////////////////////////////////////////////////////////////////////////
// Web store window (client/ui/store.html in WebView2); no controls of its own
IDR_STORE_HTML RCDATA "../ui/store.html"
IDI_PS_STORE   ICON   "store.ico"

IDD_PS_WEB DIALOGEX 0, 0, 600, 400
STYLE DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME | WS_MAXIMIZEBOX | WS_CLIPCHILDREN
CAPTION "Add-on Store"
FONT 9, "Segoe UI", 400, 0, 0x0
BEGIN
END

/////////////////////////////////////////////////////////////////////////////
// Store dialog
IDD_PS_DIALOG DIALOGEX 0, 0, 560, 282
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Add-on Store"
FONT 9, "Segoe UI", 400, 0, 0x0
BEGIN
    CONTROL         "", IDC_PS_LIST, "SysListView32",
                    LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP,
                    7, 7, 546, 140
    EDITTEXT        IDC_PS_DESC, 7, 152, 546, 44,
                    ES_MULTILINE | ES_READONLY | WS_VSCROLL | NOT WS_TABSTOP
    LTEXT           "", IDC_PS_DISCLAIMER, 7, 201, 546, 18
    LTEXT           "", IDC_PS_ADMIN_NOTE, 7, 222, 546, 10
    LTEXT           "", IDC_PS_STATUS, 7, 235, 546, 18
    PUSHBUTTON      "Update Add-on Store", IDC_PS_SELFUPDATE, 7, 261, 110, 14
    PUSHBUTTON      "Disclaimer", IDC_PS_DISCLAIMER_BTN, 121, 261, 70, 14
    PUSHBUTTON      "Refresh", IDC_PS_REFRESH, 273, 261, 60, 14
    PUSHBUTTON      "Uninstall", IDC_PS_UNINSTALL, 337, 261, 72, 14
    DEFPUSHBUTTON   "Install", IDC_PS_INSTALL, 413, 261, 70, 14
    PUSHBUTTON      "Close", IDCANCEL, 487, 261, 66, 14
END

/////////////////////////////////////////////////////////////////////////////
// Options page (File > Options > Add-on Store)
IDD_PS_OPTIONS DIALOGEX 0, 0, 320, 210
STYLE DS_SETFONT | WS_CHILD
FONT 9, "Segoe UI", 400, 0, 0x0
BEGIN
    GROUPBOX        "", IDC_PSO_GRP, 4, 4, 312, 122
    LTEXT           "", IDC_PSO_URL_LBL, 12, 18, 296, 10
    EDITTEXT        IDC_PSO_URL, 12, 30, 296, 13, ES_AUTOHSCROLL
    LTEXT           "", IDC_PSO_CODE_LBL, 12, 48, 296, 10
    EDITTEXT        IDC_PSO_CODE, 12, 60, 296, 13, ES_AUTOHSCROLL | ES_UPPERCASE
    CONTROL         "", IDC_PSO_BETA, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 12, 80, 296, 10
    LTEXT           "", IDC_PSO_HINT, 12, 94, 296, 26
    GROUPBOX        "", IDC_PSO_GRP_DIAG, 4, 130, 312, 32
    CONTROL         "", IDC_PSO_VERBOSE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 12, 143, 296, 10
    LTEXT           "", IDC_PSO_VERSION, 4, 170, 312, 10
END

