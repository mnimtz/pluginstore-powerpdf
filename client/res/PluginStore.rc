    IDS_PSD_C_SIZE      "Taille"
    IDS_PSD_BTN_INSTALL "Installer"
    IDS_PSD_BTN_REFRESH "Actualiser"
    IDS_PSD_BTN_CLOSE   "Fermer"
    IDS_PSD_ST_NOTINST  "Non installé"
    IDS_PSD_ST_INSTALLED "Installé"
    IDS_PSD_ST_UPDATE   "Mise à jour disponible"
    IDS_PSD_MSG_FAIL    "Impossible de joindre le serveur du Add-on Store. Vérifiez l’URL du serveur dans Fichier > Options > Add-on Store."
    IDS_PSD_MSG_INSTOK  "Installé. Redémarrez Power PDF pour charger le plug-in."
    IDS_PSD_MSG_INSTFAIL "Échec de l’installation (code %d)."
    IDS_PSD_CONFIRM     "Installer « %s » version %s maintenant ?\nWindows vous demandera une seule fois l’autorisation d’un administrateur."
    IDS_PSD_ADMIN_NOTE  "L’installation ou la mise à jour d’un plug-in nécessite des droits d’administrateur local (une demande par installation)."
    IDS_PSD_MSG_HASH    "Le fichier téléchargé n’a pas réussi le contrôle d’intégrité (SHA-256). Installation annulée."
    IDS_PSD_MSG_SIG     "Ce module n'est pas signé par un Add-on Store de confiance. Installation annulée. Vérifiez l'adresse du serveur dans les options ou contactez votre service informatique."
    IDS_PSD_EMPTY       "Aucun plug-in n’est encore disponible sur le serveur."
    IDS_PSD_BETA_TAG    " [Beta]"
    IDS_PSD_BTN_UNINSTALL "Désinstaller"
    IDS_PSD_CONFIRM_UNINST "Supprimer « %s » de Power PDF maintenant ?\nWindows vous demandera une seule fois l’autorisation d’un administrateur."
    IDS_PSD_MSG_UNINSTOK "Désinstallé. Redémarrez Power PDF pour décharger le plug-in."
