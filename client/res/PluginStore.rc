    IDS_PSD_BETA_TAG    " [Beta]"
    IDS_PSD_BTN_UNINSTALL "Desinstalar"
    IDS_PSD_CONFIRM_UNINST "¿Quitar ahora '%s' de Power PDF?\nWindows solicitará una sola vez la aprobación del administrador."
    IDS_PSD_MSG_UNINSTOK "Desinstalado. Reinicie Power PDF para desactivar el complemento."
