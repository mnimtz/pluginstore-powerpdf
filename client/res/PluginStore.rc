LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US
STRINGTABLE
BEGIN
    IDS_PS_TITLE        "Add-on Store"
    IDS_PS_TAB_TITLE    "Enhanced Features"
    IDS_PS_GROUP        "Add-on Store"
    IDS_PS_BTN_OPEN     "Add-on Store"
    IDS_PS_TIP_OPEN     "Browse and install plugins for Power PDF"
    IDS_PSD_TITLE       "Add-on Store"
    IDS_PSD_C_NAME      "Plugin"
    IDS_PSD_C_AVAIL     "Available"
    IDS_PSD_C_INSTALLED "Installed"
    IDS_PSD_C_STATUS    "Status"
    IDS_PSD_C_SIZE      "Size"
    IDS_PSD_BTN_INSTALL "Install"
    IDS_PSD_BTN_REFRESH "Refresh"
    IDS_PSD_BTN_CLOSE   "Close"
    IDS_PSD_ST_NOTINST  "Not installed"
    IDS_PSD_ST_INSTALLED "Installed"
    IDS_PSD_ST_UPDATE   "Update available"
    IDS_PSD_MSG_FAIL    "The plugin store server could not be reached. Check the server URL in File > Options > Add-on Store."
    IDS_PSD_MSG_INSTOK  "Installed. Restart Power PDF to load the plugin."
    IDS_PSD_MSG_INSTFAIL "Installation failed (code %d)."
    IDS_PSD_CONFIRM     "Install '%s' version %s now?\nWindows will ask once for administrator approval."
    IDS_PSD_ADMIN_NOTE  "Installing or updating a plugin requires local administrator rights (one prompt per installation)."
    IDS_PSD_MSG_HASH    "The downloaded file failed the integrity check (SHA-256). Installation aborted."
    IDS_PSD_MSG_SIG     "This add-on is not signed by a trusted Add-on Store. Installation aborted. Check the server address in the options or ask your IT."
    IDS_PSD_EMPTY       "No plugins are available on the server yet."
    IDS_PSD_BETA_TAG    " [Beta]"
    IDS_PSD_BTN_UNINSTALL "Uninstall"
    IDS_PSD_CONFIRM_UNINST "Remove '%s' from Power PDF now?\nWindows will ask once for administrator approval."
    IDS_PSD_MSG_UNINSTOK "Uninstalled. Restart Power PDF to unload the plugin."
    IDS_PSD_SELF_UPDATE "A new version of the Add-on Store is available: %s (installed: %s)."
    IDS_PSD_BTN_SELFUPD "Update Add-on Store"
    IDS_PSD_AUTHOR      "Author / contact:"
    IDS_PSD_C_AUTHOR    "Author"
    IDS_PSD_C_CONTACT   "Contact"
    IDS_PSD_DISCLAIMER  "Plugins from independent authors, not official Tungsten Automation products: provided as is, without warranty or official support. Use at your own risk; Tungsten Automation accepts no liability."
    IDS_PSD_DISCLAIMER_FULL "The plugins in this store are developed by independent authors, such as employees, partners or other developers. They are not part of Tungsten Power PDF and are not official Tungsten Automation products; the automatic checks and the review before release do not constitute a warranty.\n\nThey are provided as is, without warranty of any kind, express or implied, including fitness for a particular purpose, availability or freedom from errors.\n\nThere is no official support through Tungsten Automation Support. Please contact the author named in the catalog; answers are voluntary and without guaranteed response times.\n\nTo the extent permitted by law, Tungsten Automation accepts no liability for damage, data loss or downtime caused by installing or using these plugins. Each plugin is the responsibility of its author.\n\nTest plugins before productive use, keep backups of important documents, and make sure their use complies with your organization's IT and data protection policies."
    IDS_PSD_BTN_DISCLAIMER "Disclaimer"
    IDS_PSD_ASK_RESTART "'%s' is installed. Power PDF loads plugins at start.\n\nRestart Power PDF now? Unsaved documents are offered for saving first."
    IDS_PSD_ASK_RESTART_UN "'%s' is removed. Power PDF unloads it at the next start.\n\nRestart Power PDF now? Unsaved documents are offered for saving first."
    IDS_PSD_ASK_SELFUPD "Power PDF closes for the update, the new Add-on Store is installed and Power PDF starts again on its own. Unsaved documents are offered for saving first.\n\nUpdate now?"
    IDS_PSO_PAGE        "General"
    IDS_PSO_GRP         "Plugin store server"
    IDS_PSO_URL_LBL     "Server URL:"
    IDS_PSO_URL_HTTPS   "The server URL must start with https:// (http:// is only allowed for localhost). The store uses a single HTTPS connection; no other ports are needed."
    IDS_PSD_LINK_NOTFOUND "The add-on “%s” from the website is not in the catalog. It may only be in the beta channel (Options)."
    IDS_PSD_RESTART_FAIL "Power PDF could not be restarted automatically. Please close Power PDF and start it again yourself to finish."
    IDS_PSD_POLICY_INSTALL "Installing and removing add-ons is turned off by your administrator. You can browse the catalog."
    IDS_PSW_RATINGS        "%s rating(s)"
    IDS_PSW_YOUR_RATING    "Your rating"
    IDS_PSW_RATE_HINT      "Install the add-on to rate it."
    IDS_PSW_RATED          "Thank you for your rating."
    IDS_PSW_RATE_FAIL      "The rating could not be sent. Please check the connection to the store."
    IDS_PSW_REPORT         "Report a problem"
    IDS_PSW_REPORT_PROBLEM "Problem"
    IDS_PSW_REPORT_COMMENT "Comment or suggestion"
    IDS_PSW_REPORT_TEXT    "What happened? Describe the steps and what you expected."
    IDS_PSW_REPORT_EMAIL   "Email for questions (optional)"
    IDS_PSW_REPORT_LOG     "Attach the log of the last store actions"
    IDS_PSW_REPORT_PRIVACY "The report goes to the developer of this add-on. The versions of the add-on, Power PDF and Windows are sent along; no documents."
    IDS_PSW_SEND           "Send"
    IDS_PSW_REPORT_SENT    "Thank you. The report was sent to the developer."
    IDS_PSW_REPORT_FAIL    "The report could not be sent."
    IDS_PSW_SCREENSHOTS    "Screenshots"
    IDS_PSW_CLOSE          "Close"
    IDS_PS_TIP_UPDATES     "Add-on Store: %d update(s) available"
    IDS_PSW_FOR            "For %s"
    IDS_PSW_NEED_HINT      "Enter: search by what you need, for example split invoices by barcode"
    IDS_PSW_NEED_HITS      "Best matches for: %s"
    IDS_PSW_NEED_NONE      "No add-on found for: %s"
    IDS_PSW_NEED_ALL       "Show all"
    IDS_PSO_CODE_LBL       "Customer code (optional, from your add-on provider):"
    IDS_PSO_CODE_BAD       "The customer code may contain only letters, digits and hyphens (at most 64 characters)."
    IDS_PSW_SEARCH         "Search add-ons"
    IDS_PSW_ALL            "All"
    IDS_PSW_NONE           "No add-ons found."
    IDS_PSW_VERSION        "Version %s"
    IDS_PSW_WHATSNEW       "What’s new in %s"
    IDS_PSW_UPDATE         "Update"
    IDS_PSW_REMOVE         "Remove"
    IDS_PSW_CANCEL         "Cancel"
    IDS_PSW_LATER          "Later"
    IDS_PSW_RESTARTNOW     "Restart now"
    IDS_PSW_INSTALLING     "Installing…"
    IDS_PSW_REMOVING       "Removing…"
    IDS_PSW_BETA           "Beta"
    IDS_PSO_BETA        "Beta: show plugins that are not yet approved"
    IDS_PSO_VERSIONLBL  "Add-on Store client version %s"
    IDS_PSO_HINT        "Beta plugins passed the automatic checks but are not yet reviewed by an admin. Install them at your own risk."
    IDS_PSO_VERBOSE     "Verbose logging (%TEMP%\\PluginStore.log)"
    IDS_PSO_GRP_DIAG    "Diagnostics"
END

