<?xml version="1.0" encoding="UTF-8"?>
<!--
  Add-on Store client for Tungsten Power PDF - MSI package.

  Installs PluginStore.zxt plus its data folder (UILayout) into the Power PDF
  plug-in folder. The target is not hard-coded: the App Paths entry of
  PowerPDF.exe (or the Kofax install keys) tells us where the product lives.
  The client later updates itself by downloading the newest MSI from the store
  and running it; MajorUpgrade replaces the previous version in place.

  Languages (C0.8.0): one MSI per language from l10n\<culture>.wxl, then the
  other 15 embedded as language transforms into the English MSI (build_msi.py);
  Windows picks the one of the user's language, the self-update passes the
  Power PDF language as TRANSFORMS=:<LCID>.

  ProductVersion: build_msi.cmd derives it from common\version.h and passes it
  as -dFPVersion. Bump version.h on every release.
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi"
     xmlns:util="http://schemas.microsoft.com/wix/UtilExtension">
  <Product Id="*"
           Name="Add-on Store for Tungsten Power PDF"
           Language="!(loc.ProductLanguage)"
           Version="$(var.FPVersion)"
           Manufacturer="Tungsten Automation"
           UpgradeCode="{AFC4D7E3-52F6-4F64-BBD5-3A8F61AB67D1}">

    <Package InstallerVersion="500"
             Compressed="yes"
             InstallScope="perMachine"
             Description="Add-on Store for Tungsten Power PDF"
             Manufacturer="Tungsten Automation" />

    <MediaTemplate EmbedCab="yes" />

    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="!(loc.Downgrade)" />

    <Property Id="POWERPDFBIN">
      <RegistrySearch Id="PowerPdfAppPath"
                      Root="HKLM"
                      Key="SOFTWARE\Microsoft\Windows\CurrentVersion\App Paths\PowerPDF.exe"
                      Name="Path"
                      Type="raw"
                      Win64="yes" />
    </Property>
    <Property Id="PPDFINSTALLDIR">
      <RegistrySearch Id="KofaxInstallDir"
                      Root="HKLM" Key="SOFTWARE\Kofax\PDF" Name="InstallDir"
                      Type="raw" Win64="yes" />
    </Property>
    <Property Id="PPDFINSTALLPATH">
      <RegistrySearch Id="KofaxInstallPath"
                      Root="HKLM" Key="SOFTWARE\Kofax\PDF" Name="InstallPath"
                      Type="raw" Win64="yes" />
    </Property>
    <!-- C1.1.3 (developer tip): the product's own record of the CURRENT
         installation wins, HKLM\SOFTWARE\Kofax\PDF\V1 InstallPath. After an
         update to a new release the folder changes ("Power PDF 2025" -> "2026")
         while App Paths may still name the old one. Used only when PowerPDF.exe
         is really in <InstallPath>bin. -->
    <Property Id="PPDFROOT">
      <RegistrySearch Id="KofaxV1InstallPath" Root="HKLM" Key="SOFTWARE\Kofax\PDF\V1"
                      Name="InstallPath" Type="directory" Win64="yes" />
    </Property>
    <Property Id="PPDFV1EXE">
      <RegistrySearch Id="KofaxV1ExeRoot" Root="HKLM" Key="SOFTWARE\Kofax\PDF\V1"
                      Name="InstallPath" Type="directory" Win64="yes">
        <DirectorySearch Id="KofaxV1Bin" Path="bin" Depth="0">
          <FileSearch Id="KofaxV1Exe" Name="PowerPDF.exe" />
        </DirectorySearch>
      </RegistrySearch>
    </Property>
    <Property Id="PPDFV1NEWENOUGH">
      <RegistrySearch Id="KofaxV1ExeRootMin" Root="HKLM" Key="SOFTWARE\Kofax\PDF\V1"
                      Name="InstallPath" Type="directory" Win64="yes">
        <DirectorySearch Id="KofaxV1BinMin" Path="bin" Depth="0">
          <FileSearch Id="KofaxV1ExeMin" Name="PowerPDF.exe" MinVersion="2025.2.65535.65535" />
        </DirectorySearch>
      </RegistrySearch>
    </Property>
    <SetProperty Id="POWERPDFBIN" Action="SetBinFromV1"
                 After="AppSearch" Sequence="both"
                 Value="[PPDFROOT]bin">
      <![CDATA[PPDFROOT AND PPDFV1EXE]]>
    </SetProperty>

    <SetProperty Id="POWERPDFBIN" Action="SetBinFromInstallDir"
                 After="SetBinFromV1" Sequence="both"
                 Value="[PPDFINSTALLDIR]bin">
      <![CDATA[NOT POWERPDFBIN AND PPDFINSTALLDIR]]>
    </SetProperty>
    <SetProperty Id="POWERPDFBIN" Action="SetBinFromInstallPath"
                 After="SetBinFromInstallDir" Sequence="both"
                 Value="[PPDFINSTALLPATH]bin">
      <![CDATA[NOT POWERPDFBIN AND PPDFINSTALLPATH]]>
    </SetProperty>

    <Condition Message="!(loc.NoPowerPdf)">
      <![CDATA[Installed OR POWERPDFBIN]]>
    </Condition>

    <!-- Minimum Power PDF version (C1.1.0): 2025.3, the Plugin SDK the client is
         built with. PPDFEXE = path from App Paths; PPDFNEWENOUGH is only set when
         that file is at least 2025.3. Blocks only when the exe was found and is older. -->
    <Property Id="PPDFEXE">
      <RegistrySearch Id="PowerPdfExePath" Root="HKLM"
                      Key="SOFTWARE\Microsoft\Windows\CurrentVersion\App Paths\PowerPDF.exe"
                      Type="raw" Win64="yes" />
    </Property>
    <Property Id="PPDFNEWENOUGH">
      <RegistrySearch Id="PowerPdfExeVersion" Root="HKLM"
                      Key="SOFTWARE\Microsoft\Windows\CurrentVersion\App Paths\PowerPDF.exe"
                      Type="file" Win64="yes">
        <FileSearch Id="PowerPdfExeMin" Name="PowerPDF.exe" MinVersion="2025.2.65535.65535" />
      </RegistrySearch>
    </Property>
    <Condition Message="!(loc.PowerPdfTooOld)">
      <![CDATA[Installed OR (PPDFV1EXE AND PPDFV1NEWENOUGH) OR (NOT PPDFV1EXE AND (NOT PPDFEXE OR PPDFNEWENOUGH))]]>
    </Condition>

    <!-- Edition (C1.1.3): in Power PDF 2025 only Business loads plug-ins; from
         2026.4 on every edition. V1 "Version" is the short form ("25.3", "26.4");
         releases have single-digit minors, so the text comparison is safe, and
         anything older than 2025.3 is already refused above. Unknown names pass. -->
    <Property Id="PPDFPRODUCT">
      <RegistrySearch Id="KofaxV1Product" Root="HKLM" Key="SOFTWARE\Kofax\PDF\V1"
                      Name="ProductName" Type="raw" Win64="yes" />
    </Property>
    <Property Id="PPDFSHORTVER">
      <RegistrySearch Id="KofaxV1ShortVersion" Root="HKLM" Key="SOFTWARE\Kofax\PDF\V1"
                      Name="Version" Type="raw" Win64="yes" />
    </Property>
    <Condition Message="!(loc.PowerPdfEdition)">
      <![CDATA[Installed OR NOT PPDFPRODUCT OR NOT PPDFSHORTVER OR PPDFPRODUCT >< "Business" OR NOT (PPDFPRODUCT >< "Standard" OR PPDFPRODUCT >< "Advanced") OR PPDFSHORTVER >= "26.4"]]>
    </Condition>

    <!-- Power PDF must be closed: the .zxt is locked while it runs. -->
    <util:CloseApplication Id="ClosePowerPDF"
                           Target="PowerPDF.exe"
                           CloseMessage="no"
                           RebootPrompt="no"
                           PromptToContinue="yes"
                           Description="!(loc.ClosePowerPdf)" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <!-- Fresh installs only (never on an upgrade): the client clears the
           shared "FeaturePack" tab once per user on its first start, so
           leftovers of plug-ins that are no longer installed disappear. -->
      <Component Id="cmpFreshInstall" Guid="{3B5F0B8E-6C2A-4E0B-9F57-2D8B7A1C4E61}" Win64="yes">
        <Condition><![CDATA[NOT WIX_UPGRADE_DETECTED]]></Condition>
        <RegistryValue Root="HKLM" Key="SOFTWARE\Kofax\PDF\Tungsten Power PDF\PluginStore"
                       Name="FreshInstall" Type="string" Value="[ProductCode] [Date] [Time]" KeyPath="yes" />
      </Component>
      <Directory Id="POWERPDFBIN">
        <Directory Id="PLUGINSDIR" Name="Plug-Ins">

          <Component Id="cmpPlugin" Guid="{8C6DE33D-D93A-44BB-A8B6-4A229CA8F685}" Win64="yes">
            <File Id="filZxt"
                  Source="$(var.ProjectDir)\Release\PluginStore.zxt"
                  Name="PluginStore.zxt"
                  KeyPath="yes" />
          </Component>

          <Directory Id="PSDIR" Name="PluginStore">
            <!-- addonstore:// links from the store website ("Install in Power PDF").
                 The helper only hands a validated package id to the client. -->
            <Component Id="cmpLink" Guid="{5D7A3E19-2C64-4B8F-9E31-7F0C6A2B8D45}" Win64="yes">
              <File Id="filLink"
                    Source="$(var.ProjectDir)\link\Release\AddonStoreLink.exe"
                    Name="AddonStoreLink.exe" KeyPath="yes" />
              <RegistryKey Root="HKLM" Key="SOFTWARE\Classes\addonstore">
                <RegistryValue Type="string" Value="URL:Add-on Store" />
                <RegistryValue Name="URL Protocol" Type="string" Value="" />
                <RegistryKey Key="DefaultIcon">
                  <RegistryValue Type="string" Value="&quot;[#filLink]&quot;,0" />
                </RegistryKey>
                <RegistryKey Key="shell\open\command">
                  <RegistryValue Type="string" Value="&quot;[#filLink]&quot; &quot;%1&quot;" />
                </RegistryKey>
              </RegistryKey>
            </Component>
            <Directory Id="UILAYOUTDIR" Name="UILayout">
              <Component Id="cmpLayout" Guid="{9DF9BE9A-7052-4545-BF1A-AF1ADDD56166}" Win64="yes">
                <File Id="filNameAndTitle"
                      Source="$(var.ProjectDir)\Plug-ins\PluginStore\UILayout\NameAndTitle.xml"
                      Name="NameAndTitle.xml" KeyPath="yes" />
              </Component>
              <Component Id="cmpPublish" Guid="{6CD82DEA-DC16-44F0-8CDE-A3261D17BD18}" Win64="yes">
                <File Id="filPublishMode"
                      Source="$(var.ProjectDir)\Plug-ins\PluginStore\UILayout\Publish Mode.xml"
                      Name="Publish Mode.xml" KeyPath="yes" />
              </Component>
              <Directory Id="LANGENU" Name="ENU">
                <Component Id="cmpENU" Guid="{2CC75583-EE6D-45A5-AF82-71A2D749B488}" Win64="yes">
                  <File Id="filENU" Source="$(var.ProjectDir)\Plug-ins\PluginStore\UILayout\ENU\NameAndTitle.xml"
                        Name="NameAndTitle.xml" KeyPath="yes" />
                </Component>
              </Directory>
              <Directory Id="LANGFRA" Name="FRA">
                <Component Id="cmpFRA" Guid="{020B06C9-9118-4B30-9F15-C94F227FE590}" Win64="yes">
                  <File Id="filFRA" Source="$(var.ProjectDir)\Plug-ins\PluginStore\UILayout\FRA\NameAndTitle.xml"
                        Name="NameAndTitle.xml" KeyPath="yes" />
                </Component>
              </Directory>
              <Directory Id="LANGITA" Name="ITA">
                <Component Id="cmpITA" Guid="{AAF62DA1-6D1B-406F-97F9-F8CED2AE33C0}" Win64="yes">
                  <File Id="filITA" Source="$(var.ProjectDir)\Plug-ins\PluginStore\UILayout\ITA\NameAndTitle.xml"
                        Name="NameAndTitle.xml" KeyPath="yes" />
                </Component>
              </Directory>
              <Directory Id="LANGESP" Name="ESP">
                <Component Id="cmpESP" Guid="{5B754679-AC42-4110-83A4-367D02CECE13}" Win64="yes">
                  <File Id="filESP" Source="$(var.ProjectDir)\Plug-ins\PluginStore\UILayout\ESP\NameAndTitle.xml"
                        Name="NameAndTitle.xml" KeyPath="yes" />
                </Component>
              </Directory>
              <Directory Id="LANGNLD" Name="NLD">
                <Component Id="cmpNLD" Guid="{B611F6B6-81BB-4B6E-B2F3-FECA8096B0B4}" Win64="yes">
                  <File Id="filNLD" Source="$(var.ProjectDir)\Plug-ins\PluginStore\UILayout\NLD\NameAndTitle.xml"
                        Name="NameAndTitle.xml" KeyPath="yes" />
                </Component>
              </Directory>
              <Directory Id="LANGPTB" Name="PTB">
                <Component Id="cmpPTB" Guid="{2ED0FC10-941F-49DF-B1A5-5E6E50FC47EC}" Win64="yes">
                  <File Id="filPTB" Source="$(var.ProjectDir)\Plug-ins\PluginStore\UILayout\PTB\NameAndTitle.xml"
                        Name="NameAndTitle.xml" KeyPath="yes" />
                </Component>
              </Directory>
              <Directory Id="LANGDAN" Name="DAN">
                <Component Id="cmpDAN" Guid="{DA4045A3-7699-4DAD-8451-633825654E55}" Win64="yes">
                  <File Id="filDAN" Source="$(var.ProjectDir)\Plug-ins\PluginStore\UILayout\DAN\NameAndTitle.xml"
                        Name="NameAndTitle.xml" KeyPath="yes" />
                </Component>
              </Directory>
              <Directory Id="LANGFIN" Name="FIN">
                <Component Id="cmpFIN" Guid="{802D81D9-2E50-4090-99FF-2961C174737A}" Win64="yes">
                  <File Id="filFIN" Source="$(var.ProjectDir)\Plug-ins\PluginStore\UILayout\FIN\NameAndTitle.xml"
                        Name="NameAndTitle.xml" KeyPath="yes" />
                </Component>
              </Directory>
              <Directory Id="LANGNOR" Name="NOR">
                <Component Id="cmpNOR" Guid="{67DA0855-AFAE-4D8B-ABAD-28185E4927FF}" Win64="yes">
                  <File Id="filNOR" Source="$(var.ProjectDir)\Plug-ins\PluginStore\UILayout\NOR\NameAndTitle.xml"
                        Name="NameAndTitle.xml" KeyPath="yes" />
                </Component>
              </Directory>
              <Directory Id="LANGSVE" Name="SVE">
                <Component Id="cmpSVE" Guid="{B74EF5FF-51A2-4E76-860C-47BF7173F990}" Win64="yes">
                  <File Id="filSVE" Source="$(var.ProjectDir)\Plug-ins\PluginStore\UILayout\SVE\NameAndTitle.xml"
                        Name="NameAndTitle.xml" KeyPath="yes" />
                </Component>
              </Directory>
              <Directory Id="LANGPLK" Name="PLK">
                <Component Id="cmpPLK" Guid="{72D0EFBB-0A6A-47A7-9C34-389400C2B4C0}" Win64="yes">
                  <File Id="filPLK" Source="$(var.ProjectDir)\Plug-ins\PluginStore\UILayout\PLK\NameAndTitle.xml"
                        Name="NameAndTitle.xml" KeyPath="yes" />
                </Component>
              </Directory>
              <Directory Id="LANGCSY" Name="CSY">
                <Component Id="cmpCSY" Guid="{26F367AB-8CE1-4D91-8E74-EBE2A458E5C6}" Win64="yes">
                  <File Id="filCSY" Source="$(var.ProjectDir)\Plug-ins\PluginStore\UILayout\CSY\NameAndTitle.xml"
                        Name="NameAndTitle.xml" KeyPath="yes" />
                </Component>
              </Directory>
              <Directory Id="LANGHUN" Name="HUN">
                <Component Id="cmpHUN" Guid="{AD974606-348E-4E63-9471-60B958F31E02}" Win64="yes">
                  <File Id="filHUN" Source="$(var.ProjectDir)\Plug-ins\PluginStore\UILayout\HUN\NameAndTitle.xml"
                        Name="NameAndTitle.xml" KeyPath="yes" />
                </Component>
              </Directory>
              <Directory Id="LANGRUS" Name="RUS">
                <Component Id="cmpRUS" Guid="{20621EFE-16DE-42EE-A558-8F6A15C11796}" Win64="yes">
                  <File Id="filRUS" Source="$(var.ProjectDir)\Plug-ins\PluginStore\UILayout\RUS\NameAndTitle.xml"
                        Name="NameAndTitle.xml" KeyPath="yes" />
                </Component>
              </Directory>
              <Directory Id="LANGTRK" Name="TRK">
                <Component Id="cmpTRK" Guid="{5DCAE91D-27FB-4BE4-84DC-D9CEC181C231}" Win64="yes">
                  <File Id="filTRK" Source="$(var.ProjectDir)\Plug-ins\PluginStore\UILayout\TRK\NameAndTitle.xml"
                        Name="NameAndTitle.xml" KeyPath="yes" />
                </Component>
              </Directory>
              <Directory Id="LANGDEU" Name="DEU">
                <Component Id="cmpDeu" Guid="{0CDC1E08-BD11-411D-97C3-37D9E0339E9A}" Win64="yes">
                  <File Id="filDeu" Source="$(var.ProjectDir)\Plug-ins\PluginStore\UILayout\DEU\NameAndTitle.xml"
                        Name="NameAndTitle.xml" KeyPath="yes" />
                </Component>
              </Directory>
            </Directory>
          </Directory>
        </Directory>
      </Directory>
    </Directory>

    <Feature Id="Core" Title="Add-on Store" Level="1" Absent="disallow">
      <ComponentRef Id="cmpPlugin" />
      <ComponentRef Id="cmpFreshInstall" />
      <ComponentRef Id="cmpLink" />
      <ComponentRef Id="cmpLayout" />
      <ComponentRef Id="cmpPublish" />
      <ComponentRef Id="cmpDeu" />
      <ComponentRef Id="cmpENU" />
      <ComponentRef Id="cmpFRA" />
      <ComponentRef Id="cmpITA" />
      <ComponentRef Id="cmpESP" />
      <ComponentRef Id="cmpNLD" />
      <ComponentRef Id="cmpPTB" />
      <ComponentRef Id="cmpDAN" />
      <ComponentRef Id="cmpFIN" />
      <ComponentRef Id="cmpNOR" />
      <ComponentRef Id="cmpSVE" />
      <ComponentRef Id="cmpPLK" />
      <ComponentRef Id="cmpCSY" />
      <ComponentRef Id="cmpHUN" />
      <ComponentRef Id="cmpRUS" />
      <ComponentRef Id="cmpTRK" />
    </Feature>

    <UIRef Id="WixUI_Minimal" />
    <!-- per language: build_msi.py passes -dWixUILicenseRtf=l10n\license-<culture>.rtf to light -->
    <WixVariable Id="WixUILicenseRtf" Value="$(var.ProjectDir)\installer\l10n\license-en-US.rtf" Overridable="yes" />

  </Product>
</Wix>
