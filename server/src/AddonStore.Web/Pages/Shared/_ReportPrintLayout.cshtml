@using System.Globalization
<!DOCTYPE html>
<html lang="@AddonStore.Web.Services.Lang.Current" dir="@(AddonStore.Web.Services.Lang.CurrentIsRtl ? "rtl" : "ltr")" class="report-print">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Add-on Store · @(ViewData["PrintTitle"] as string ?? L["Reports"].Value) · @DateTime.UtcNow.ToString("yyyy-MM-dd")</title>
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<main>
    <div class="print-toolbar no-print">
        <span>@L["Use \"Save as PDF\" as the printer to get the report as a PDF file."]</span>
        <button type="button" class="btn small" id="print-btn">@L["Print / save as PDF"]</button>
    </div>
    @RenderBody()
</main>
<script nonce="@ViewContext.HttpContext.Items["CspNonce"]">
document.getElementById('print-btn').addEventListener('click', function () { window.print(); });
    // Open the print dialog once the page (including the logo) has rendered (not for the audit dossier, S1.3.0).
    @if (ViewData["NoAutoPrint"] is not true)
    {
        @:window.addEventListener('load', function () { setTimeout(function () { window.print(); }, 300); });
    }
</script>
</body>
</html>
