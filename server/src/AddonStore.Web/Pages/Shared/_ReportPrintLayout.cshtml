@using System.Globalization
<!DOCTYPE html>
<html lang="@AddonStore.Web.Services.Lang.Current" dir="@(AddonStore.Web.Services.Lang.CurrentIsRtl ? "rtl" : "ltr")" class="report-print">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Add-on Store · @(ViewData["PrintTitle"] as string ?? L["Reports"].Value) · @DateTime.UtcNow.ToString("yyyy-MM-dd")</title>
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<main>
    <div class="print-toolbar no-print">
        <span>@L["Use \"Save as PDF\" as the printer to get the report as a PDF file."]</span>
        @if (ViewData["LangSwitch"] is true)
        {
            // language of the document (S1.4.0): English by default, any Power PDF language on request
            <form method="get" class="print-lang" style="display:inline-flex;gap:6px;align-items:center;margin-inline-start:auto">
                <label class="small">@L["Report language"]
                    <select name="rlang" id="rlang-sel">
                        @foreach (var lg in AddonStore.Web.Services.Lang.Ui)
                        {
                            <option value="@lg" selected="@(lg == AddonStore.Web.Services.Lang.Current)">@AddonStore.Web.Services.Lang.NativeNames[lg]</option>
                        }
                    </select>
                </label>
                <button type="submit" class="btn small secondary">@L["Apply"]</button>
            </form>
        }
        <button type="button" class="btn small" id="print-btn">@L["Print / save as PDF"]</button>
    </div>
    @RenderBody()
</main>
<script nonce="@ViewContext.HttpContext.Items["CspNonce"]">
document.getElementById('print-btn').addEventListener('click', function () { window.print(); });
var rlangSel = document.getElementById('rlang-sel');
if (rlangSel) rlangSel.addEventListener('change', function () { rlangSel.form.submit(); });
    // Open the print dialog once the page (including the logo) has rendered (not for the audit dossier, S1.3.0).
    @if (ViewData["NoAutoPrint"] is not true)
    {
        @:window.addEventListener('load', function () { setTimeout(function () { window.print(); }, 300); });
    }
</script>
</body>
</html>
