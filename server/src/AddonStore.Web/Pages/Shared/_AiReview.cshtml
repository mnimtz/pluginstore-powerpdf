@model (AddonStore.Web.Data.PackageVersion V, bool CanCreate)
@* AI review aid of one version (S0.12.0): stored result plus the button to (re)create it. *@
@{
    var v = Model.V;
    var rv = AddonStore.Web.Services.AiAssist.ParseReview(v.AiReviewJson);
    // The text is written in one language; offer to recreate it in the viewer's.
    var ui = AddonStore.Web.Services.AiAssist.ReviewLanguage(AddonStore.Web.Services.Lang.Current);
    string LangName(string code) { var n = new System.Globalization.CultureInfo(code).NativeName; return char.ToUpper(n[0]) + n[1..]; }
    var otherLang = rv is not null && v.AiReviewLang is not null && v.AiReviewLang != ui;
}
<div class="ai-box">
    <div class="ai-head">
        <b>@L["AI review aid"]</b>
        @if (rv is not null)
        {
            <span class="badge @(rv.Recommendation == "approve" ? "live" : rv.Recommendation == "reject" ? "rejected" : "pending")">@L[rv.Recommendation == "approve" ? "Suggests: approve" : rv.Recommendation == "reject" ? "Suggests: reject" : "Suggests: check more closely"]</span>
            <span class="muted small">@v.AiReviewModel · @Time.Fmt(v.AiReviewAt)</span>
        }
        @if (Model.CanCreate)
        {
            <form method="post" asp-page-handler="AiReview" asp-route-id="@v.PackageId" style="display:inline">
                <input type="hidden" name="versionId" value="@v.Id" />
                <button type="submit" class="btn small secondary">@(otherLang ? L["Create in {0}", LangName(ui)] : L[rv is null ? "Create AI review aid" : "Create again"])</button>
            </form>
        }
    </div>
    @if (rv is not null)
    {
        @if (otherLang)
        {
            <p class="muted small">@L["This review aid is written in {0}.", LangName(v.AiReviewLang!)]</p>
        }
        <p>@rv.Summary</p>
        @if (rv.Changes.Count > 0)
        {
            <ul class="small">@foreach (var ch in rv.Changes) { <li>@ch</li> }</ul>
        }
        <p class="small"><b>@L["Changelog matches the changes"]:</b>
            @L[rv.ChangelogFits == "yes" ? "yes" : rv.ChangelogFits == "partly" ? "partly" : rv.ChangelogFits == "no" ? "no" : "unknown"]@(rv.ChangelogComment.Length > 0 ? " · " + rv.ChangelogComment : "")</p>
        @if (rv.Concerns.Count > 0)
        {
            <ul class="small ai-concerns">
                @foreach (var cn in rv.Concerns)
                {
                    <li><span class="badge @(cn.Severity == "high" ? "rejected" : cn.Severity == "warning" ? "pending" : "submitted")">@L[cn.Severity == "high" ? "high" : cn.Severity == "warning" ? "warning" : "info"]</span> @cn.Text</li>
                }
            </ul>
        }
        <p class="muted small">@L["Generated by AI as an aid. The decision and its responsibility stay with the reviewer."]</p>
    }
</div>
