@using System.Globalization
@inject AddonStore.Web.Api.AppVersion AppVer
<!DOCTYPE html>
<html lang="@CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(ViewData["Title"] is string t && t.Length > 0 ? t + " · " : "")Add-on Store</title>
    <link rel="icon" href="/img/store-icon.png" />
    <link rel="stylesheet" href="/css/site.css" />
    <script>
        // no-win: addonstore:// install links only work on Windows. mobile: phones and
        // tablets get no client download either (a Mac may still fetch it for a VM).
        (function (ua, c) {
            if (!/Windows/i.test(ua)) c.add('no-win');
            if (/Android|iPhone|iPad|iPod|Mobile/i.test(ua) || (/Macintosh/.test(ua) && navigator.maxTouchPoints > 1)) c.add('mobile');
        })(navigator.userAgent, document.documentElement.classList);
    </script>
</head>
<body>
<header class="site">
    <div class="bar">
        <img class="logo" src="/img/tungsten-logo-white.svg" alt="Tungsten Automation" />
        <div class="title">Add-on Store<small>Tungsten Power PDF</small></div>
        <button type="button" class="nav-toggle" aria-label="@L["Menu"]" aria-expanded="false" aria-controls="site-nav"
                onclick="var h=this.closest('header');var o=h.classList.toggle('open');this.setAttribute('aria-expanded',o)">
            <span></span><span></span><span></span>
        </button>
        <nav id="site-nav">
            <a href="/">@L["Catalog"]</a>
            @if (SignInManager.IsSignedIn(User))
            {
                <a href="/Dashboard">@L["Plug-ins"]</a>
                <a href="/Profile">@L["Profile"]</a>
                <a href="/Developer">API</a>
                @if (User.IsInRole("Admin") || User.IsInRole("Reviewer"))
                {
                    <a href="/Admin/Review">@L["Review"]</a>
                }
                @if (User.IsInRole("Admin"))
                {
                    <a href="/Admin/Users">@L["Users"]</a>
                    <a href="/Admin/Audit">@L["Audit"]</a>
                    <a href="/Admin/Settings">@L["Settings"]</a>
                }
                var me = await UserManager.GetUserAsync(User);
                @if (me?.AvatarFile is not null)
                {
                    <img src="/avatar/@me.Id" alt="" style="width:28px;height:28px;border-radius:50%;object-fit:cover;border:1px solid rgba(255,255,255,.4)" />
                }
                <form method="post" action="/Account/Logout" style="display:inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn small secondary">@L["Sign out"]</button>
                </form>
            }
            else
            {
                <a href="/Account/Login">@L["Sign in"]</a>
            }
            <select onchange="location='/set-lang?culture='+this.value+'&returnUrl='+encodeURIComponent(location.pathname)" aria-label="Language"
                    style="width:auto;padding:4px 6px;font-size:.82rem">
                @{
                    var current = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
                    var langs = new[] { "en", "de", "fr", "it", "es", "nl", "pt", "da", "fi", "nb", "sv", "pl", "cs", "hu", "ru", "tr" };
                }
                @foreach (var lang in langs)
                {
                    <option value="@lang" selected="@(lang == current || (lang == "nb" && current == "no"))">@lang.ToUpperInvariant()</option>
                }
            </select>
        </nav>
    </div>
</header>
<div class="accent-line"></div>
<main>
    @RenderBody()
</main>
<footer class="site">
    <img src="/img/tungsten-logo-navy.svg" alt="Tungsten Automation" />
    <span>Add-on Store S@(AppVer.Value)</span>
    <span class="spacer"></span>
    <a href="/Disclaimer" style="color:var(--tun-slate)">@L["Disclaimer"]</a>
    <a href="/api/agent-guide" style="color:var(--tun-slate)">API</a>
</footer>
<script>
// Phones: tables whose first row holds only headers become one card per row
// (CSS in site.css, .rtable); each cell is labelled with its column name.
document.querySelectorAll('main table').forEach(function (t) {
    var head = t.rows[0];
    if (!head || t.classList.contains('no-rtable')) return;
    var ths = Array.prototype.slice.call(head.cells);
    if (!ths.length || ths.some(function (c) { return c.tagName !== 'TH'; })) return;
    t.classList.add('rtable');
    head.classList.add('rhead');
    var labels = ths.map(function (c) { return c.textContent.trim(); });
    Array.prototype.slice.call(t.rows, 1).forEach(function (r) {
        if (r.cells.length !== labels.length) { r.classList.add('rsub'); return; }
        Array.prototype.forEach.call(r.cells, function (c, i) {
            if (labels[i]) c.setAttribute('data-label', labels[i]);
            if (i === 0) c.classList.add('rtitle');
            else if (c.textContent.trim().length > 32 || c.querySelector('textarea, input, select, details, table, ul')) c.classList.add('rblock');
            if (!labels[i] || (i === labels.length - 1 && c.querySelector('form, a.btn, button'))) c.classList.add('actions');
        });
    });
});
</script>
</body>
</html>
