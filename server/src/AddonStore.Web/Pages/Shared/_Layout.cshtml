@inject AddonStore.Web.Services.IssueService IssuesNav
@inject AddonStore.Web.Data.AppDbContext NavDb
@using Microsoft.EntityFrameworkCore
@using System.Globalization
@inject AddonStore.Web.Api.AppVersion AppVer
@inject AddonStore.Web.Services.InventoryService InvNav
<!DOCTYPE html>
<html lang="@AddonStore.Web.Services.Lang.Current" dir="@(AddonStore.Web.Services.Lang.CurrentIsRtl ? "rtl" : "ltr")">
@{
    // Bookmark / shortcut / tab name: the start page carries the full product
    // name, every other page "<page> · Add-on Store for Power PDF" (localized).
    var siteName = L["Add-on Store for Tungsten Power PDF"].Value;
    var pageTitle = ViewData["Title"] is string t && t.Length > 0
        ? L[t].Value + " · " + L["Add-on Store for Power PDF"].Value
        : siteName;
    var description = ViewData["Description"] as string
        ?? L["Add-ons for Tungsten Power PDF: discover them here and install them directly in Power PDF."].Value;
    var host = Context.Request.Host;
    // the new navigation (S1.5.0 preview): signed in, switched on, and not a public page
    var shell = SignInManager.IsSignedIn(User) && AddonStore.Web.Services.Shell.Sidebar(Context) && ViewData["PublicPage"] is not true;
    // "Existing customers" only exists while the evaluation is switched on (Settings, data protection; S1.10.0)
    var invNav = SignInManager.IsSignedIn(User) && User.IsInRole("Admin") && await InvNav.EnabledAsync();
    var origin = (host.Host is "localhost" or "127.0.0.1" ? Context.Request.Scheme : "https") + "://" + host;
}
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@pageTitle</title>
    <meta name="description" content="@description" />
    <meta name="application-name" content="Add-on Store" />
    <meta name="apple-mobile-web-app-title" content="Add-on Store" />
    <meta name="theme-color" content="#002854" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/img/favicon-32.png" />
    <link rel="apple-touch-icon" href="/img/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    @if (ViewData["OgCustom"] is not true)
    {
        <meta property="og:type" content="website" />
        <meta property="og:site_name" content="@siteName" />
        <meta property="og:title" content="@pageTitle" />
        <meta property="og:description" content="@description" />
        <meta property="og:url" content="@(origin + Context.Request.Path)" />
        <meta property="og:image" content="@(origin)/img/social-card.png" />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:locale" content="@CultureInfo.CurrentUICulture.Name" />
        <meta name="twitter:card" content="summary_large_image" />
    }
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script nonce="@ViewContext.HttpContext.Items["CspNonce"]">
        // no-win: addonstore:// install links only work on Windows. mobile: phones and
        // tablets get no client download either (a Mac may still fetch it for a VM).
        (function (ua, c) {
            if (!/Windows/i.test(ua)) c.add('no-win');
            if (/Android|iPhone|iPad|iPod|Mobile/i.test(ua) || (/Macintosh/.test(ua) && navigator.maxTouchPoints > 1)) c.add('mobile');
        })(navigator.userAgent, document.documentElement.classList);
    </script>
    @await RenderSectionAsync("Head", required: false)
</head>
<body class="@(shell ? "with-shell" : "")">
@if (shell)
{
    // ---- new navigation (S1.5.0 preview): top bar with the account menu, sidebar with the areas
    var meS = await UserManager.GetUserAsync(User);
    var isAdminS = User.IsInRole("Admin");
    var isReviewerS = isAdminS || User.IsInRole("Reviewer");
    var openS = meS is null ? 0 : await IssuesNav.Scope(meS, isAdminS).CountAsync(f => f.Status == "open");
    var reviewS = isReviewerS ? await NavDb.PackageVersions.CountAsync(v => v.Status == AddonStore.Web.Data.VersionStatus.Submitted &&
                                    !NavDb.Packages.Any(p => p.Id == v.PackageId && p.Visibility == "private")) : 0;
    var pendingS = isAdminS ? await NavDb.Users.CountAsync(u => u.Status == AddonStore.Web.Data.UserStatus.Pending) : 0;
    var pathS = Context.Request.Path.Value ?? "/";
    var viewS = Context.Request.Query["view"].ToString();
    bool At(params string[] prefixes) => prefixes.Any(p => pathS.Equals(p, StringComparison.OrdinalIgnoreCase) || pathS.StartsWith(p + "/", StringComparison.OrdinalIgnoreCase));
    string On(params string[] prefixes) => At(prefixes) ? "active" : "";
    var backS = Uri.EscapeDataString(Context.Request.Path + Context.Request.QueryString);
    var settingsArea = At("/Admin/Settings", "/Admin/Backup", "/Admin/Categories", "/Admin/Rules");
    <header class="site shell-top">
        <div class="bar">
            <button type="button" class="nav-toggle shell-toggle" aria-label="@L["Menu"]" aria-expanded="false" aria-controls="side-nav">
                <span></span><span></span><span></span>
            </button>
            <a class="brand" href="/Start">
                <img class="logo" src="/img/tungsten-logo-white.svg" alt="Tungsten Automation" />
                <div class="title">Add-on Store<small>Tungsten Power PDF</small></div>
            </a>
            <span class="spacer"></span>
            <a class="top-link" href="/">@L["Catalog"]</a>
            <details class="user-menu">
                <summary aria-label="@L["Account"]">
                    @if (meS?.AvatarFile is not null)
                    {
                        <img src="/avatar/@meS.Id" alt="" />
                    }
                    else
                    {
                        <span class="initial">@((meS?.DisplayName ?? "?").Trim().FirstOrDefault())</span>
                    }
                    <span class="who">@meS?.DisplayName</span>
                </summary>
                <div class="user-pop">
                    <a href="/Profile">@L["Profile"]</a>
                    <label class="small">@L["Language"]
                        <select id="lang-select" aria-label="Language">
                            @foreach (var lang in AddonStore.Web.Services.Lang.Ui)
                            {
                                <option value="@lang" selected="@(lang == AddonStore.Web.Services.Lang.Current)">@AddonStore.Web.Services.Lang.NativeNames[lang]</option>
                            }
                        </select>
                    </label>
                    <a href="/set-shell?mode=classic&returnUrl=@backS">@L["Classic navigation"]</a>
                    <form method="post" action="/Account/Logout">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn small secondary">@L["Sign out"]</button>
                    </form>
                </div>
            </details>
        </div>
    </header>
    <div class="accent-line"></div>
    <div class="shell">
        <nav class="side-nav" id="side-nav" aria-label="@L["Navigation"]">
            <a class="@On("/Start")" href="/Start">@L["Start"]</a>
            <div class="side-head">@L["My work"]</div>
            <a class="@On("/Insights")" href="/Insights">@L["Dashboard"]</a>
            <a class="@On("/Dashboard", "/Plugin", "/CatalogEntry", "/Dossier")" href="/Dashboard">@L["Plug-ins"]</a>
            <a class="@On("/Issues")" href="/Issues"><span>@L["Problem reports"]</span>@if (openS > 0) { <span class="nav-count" title="@L["New problem reports"]">@openS</span> }</a>
            <a class="@On("/Customers", "/Customer")" href="/Customers">@L["Deliveries"]</a>
            @if (invNav)
            {
                <a class="@On("/Admin/Inventory")" href="/Admin/Inventory">@L["Existing customers"]</a>
            }
            @if (isReviewerS)
            {
                <div class="side-head">@L["Review"]</div>
                <a class="@On("/Admin/Review")" href="/Admin/Review"><span>@L["Review queue"]</span>@if (reviewS > 0) { <span class="nav-count">@reviewS</span> }</a>
            }
            @if (isAdminS)
            {
                <div class="side-head">@L["Administration"]</div>
                <a class="@On("/Admin/Users")" href="/Admin/Users"><span>@L["Users"]</span>@if (pendingS > 0) { <span class="nav-count" title="@L["Access requests"]">@pendingS</span> }</a>
                <a class="@(At("/Admin/Reports") ? "open" : "")" href="/Admin/Reports">@L["Reports"]</a>
                @if (At("/Admin/Reports"))
                {
                    @foreach (var (key, label) in AddonStore.Web.Pages.Admin.ReportsModel.Views)
                    {
                        var act = viewS == key || (key == "overview" && viewS.Length == 0);
                        <a class="sub @(act ? "active" : "")" href="/Admin/Reports@(key == "overview" ? "" : "?view=" + key)">@L[label]</a>
                    }
                }
                <a class="@On("/Admin/Audit")" href="/Admin/Audit">@L["Audit"]</a>
                <a class="@(settingsArea ? "open" : "")" href="/Admin/Settings">@L["Settings"]</a>
                @if (settingsArea)
                {
                    @foreach (var (key, label) in AddonStore.Web.Pages.Admin.SettingsModel.Views)
                    {
                        var act = At("/Admin/Settings") && (viewS == key || (key == "server" && viewS.Length == 0));
                        <a class="sub @(act ? "active" : "")" href="/Admin/Settings@(key == "server" ? "" : "?view=" + key)">@L[label]</a>
                    }
                    <a class="sub @On("/Admin/Backup")" href="/Admin/Backup">@L["Backup and restore"]</a>
                    <a class="sub @On("/Admin/Categories")" href="/Admin/Categories">@L["Categories"]</a>
                    <a class="sub @On("/Admin/Rules")" href="/Admin/Rules">@L["Rules"]</a>
                }
            }
            <div class="side-head">@L["Help"]</div>
            <a class="@On("/Docs", "/Admin/Docs")" href="/Docs">@L["Documentation"]</a>
            <a class="@On("/Developer")" href="/Developer">API</a>
            @if (!isAdminS)
            {
                <a class="@On("/Admin/Rules")" href="/Admin/Rules">@L["Rules"]</a>
            }
        </nav>
        <main class="shell-main">
            @RenderBody()
        </main>
    </div>
}
else
{
<header class="site">
    <div class="bar">
        <img class="logo" src="/img/tungsten-logo-white.svg" alt="Tungsten Automation" />
        <div class="title">Add-on Store<small>Tungsten Power PDF</small></div>
        <button type="button" class="nav-toggle" aria-label="@L["Menu"]" aria-expanded="false" aria-controls="site-nav">
            <span></span><span></span><span></span>
        </button>
        <nav id="site-nav">
            <a href="/">@L["Catalog"]</a>
            @if (SignInManager.IsSignedIn(User))
            {
                <a href="/Dashboard">@L["Plug-ins"]</a>
                <a href="/Profile">@L["Profile"]</a>
                <a href="/Customers">@L["Deliveries"]</a>
                @if (invNav)
                {
                    <a href="/Admin/Inventory">@L["Existing customers"]</a>
                }
                <a href="/Insights">@L["Dashboard"]</a>
                var meNav = await UserManager.GetUserAsync(User);
                var openReports = meNav is null ? 0 : await IssuesNav.Scope(meNav, User.IsInRole("Admin")).CountAsync(f => f.Status == "open");
                <a href="/Issues">@L["Problem reports"]@if (openReports > 0) { <span class="nav-count" title="@L["New problem reports"]">@openReports</span> }</a>
                <a href="/Developer">API</a>
                <a href="/Docs">@L["Documentation"]</a>
                @if (User.IsInRole("Admin") || User.IsInRole("Reviewer"))
                {
                    <a href="/Admin/Review">@L["Review"]</a>
                }
                @if (User.IsInRole("Admin"))
                {
                    <a href="/Admin/Users">@L["Users"]</a>
                    <a href="/Admin/Reports">@L["Reports"]</a>
                    <a href="/Admin/Audit">@L["Audit"]</a>
                    <a href="/Admin/Settings">@L["Settings"]</a>
                }
                var me = await UserManager.GetUserAsync(User);
                @if (me?.AvatarFile is not null)
                {
                    <img src="/avatar/@me.Id" alt="" style="width:28px;height:28px;border-radius:50%;object-fit:cover;border:1px solid rgba(255,255,255,.4)" />
                }
                <form method="post" action="/Account/Logout" style="display:inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn small secondary">@L["Sign out"]</button>
                </form>
            }
            else
            {
                <a href="/Account/Login">@L["Sign in"]</a>
            }
            <select id="lang-select" aria-label="Language"
                    style="width:auto;padding:4px 6px;font-size:.82rem">
                @{
                    var current = AddonStore.Web.Services.Lang.Current;
                }
                @foreach (var lang in AddonStore.Web.Services.Lang.Ui)
                {
                    <option value="@lang" selected="@(lang == current)" title="@AddonStore.Web.Services.Lang.NativeNames[lang]">@AddonStore.Web.Services.Lang.ShortLabel(lang)</option>
                }
            </select>
        </nav>
    </div>
</header>
<div class="accent-line"></div>
<main>
    @RenderBody()
</main>
}
<footer class="site">
    <img src="/img/tungsten-logo-navy.svg" alt="Tungsten Automation" />
    <span>Add-on Store S@(AppVer.Value)</span>
    <span class="spacer"></span>
    @if (!(User.Identity?.IsAuthenticated ?? false))
    {
        <a class="btn small secondary" href="/Account/Register">@L["Request a developer account"]</a>
    }
    @if (SignInManager.IsSignedIn(User) && !shell)
    {
        <a href="/set-shell?mode=sidebar&returnUrl=/Start" style="color:var(--tun-slate)">@L["Try the new navigation (preview)"]</a>
    }
    <a href="/Disclaimer" style="color:var(--tun-slate)">@L["Disclaimer"]</a>
    <a href="/api/agent-guide" style="color:var(--tun-slate)">API</a>
</footer>
<script nonce="@ViewContext.HttpContext.Items["CspNonce"]">
// Behaviour without inline handlers (CSP): menu toggle, language switch,
// confirmations (data-confirm), image fallbacks (data-fallback), print buttons.
(function () {
    var t = document.querySelector('.nav-toggle');
    var sh = document.querySelector('.shell');
    if (t) t.addEventListener('click', function () {
        var o = sh ? sh.classList.toggle('side-open') : t.closest('header').classList.toggle('open');
        t.setAttribute('aria-expanded', o);
    });
    // the sidebar drawer (small screens) closes on a click beside it or Escape
    if (sh && t) {
        var shut = function () { sh.classList.remove('side-open'); t.setAttribute('aria-expanded', false); };
        document.addEventListener('click', function (e) {
            if (sh.classList.contains('side-open') && !e.target.closest('.side-nav') && !e.target.closest('.nav-toggle')) shut();
        });
        document.addEventListener('keydown', function (e) { if (e.key === 'Escape') shut(); });
    }
    // the account menu closes on a click elsewhere or Escape
    var um = document.querySelector('details.user-menu');
    if (um) {
        document.addEventListener('click', function (e) { if (um.open && !um.contains(e.target)) um.open = false; });
        document.addEventListener('keydown', function (e) { if (e.key === 'Escape') um.open = false; });
    }
    var ls = document.getElementById('lang-select');
    if (ls) ls.addEventListener('change', function () {
        location = '/set-lang?culture=' + encodeURIComponent(ls.value) + '&returnUrl=' + encodeURIComponent(location.pathname);
    });
    // Confirmations as an in-page dialog (no browser popup): message from
    // data-confirm, the confirm button carries the label of the button that was
    // clicked ("Delete customer"), Cancel is focused (safe default), Escape cancels.
    var cancelLabel = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["Cancel"].Value));
    document.addEventListener('submit', function (e) {
        var f = e.target;
        if (!f.dataset || !f.dataset.confirm) return;
        if (f.dataset.confirmed === '1') { f.dataset.confirmed = ''; return; }
        e.preventDefault();
        var submitter = e.submitter || f.querySelector('button[type=submit],button:not([type])');
        var dlg = document.createElement('dialog');
        dlg.className = 'pp-confirm';
        var p = document.createElement('p'); p.textContent = f.dataset.confirm; dlg.appendChild(p);
        var row = document.createElement('div'); row.className = 'pp-confirm-actions';
        var no = document.createElement('button'); no.type = 'button'; no.className = 'btn secondary'; no.textContent = cancelLabel;
        var yes = document.createElement('button'); yes.type = 'button';
        var danger = submitter && submitter.classList.contains('danger');
        yes.className = 'btn ' + (danger ? 'danger' : 'cta');
        yes.textContent = (submitter && submitter.textContent.trim()) || 'OK';
        row.appendChild(no); row.appendChild(yes); dlg.appendChild(row);
        document.body.appendChild(dlg);
        function close() { dlg.close(); dlg.remove(); }
        no.addEventListener('click', close);
        dlg.addEventListener('cancel', function (ev) { ev.preventDefault(); close(); });
        dlg.addEventListener('click', function (ev) { if (ev.target === dlg) close(); });   // click on the backdrop
        yes.addEventListener('click', function () {
            close();
            f.dataset.confirmed = '1';
            if (f.requestSubmit) f.requestSubmit(submitter && submitter.form === f ? submitter : undefined); else f.submit();
        });
        dlg.showModal();
        no.focus();
    }, true);
    document.addEventListener('error', function (e) {
        var i = e.target;
        if (i.tagName === 'IMG' && i.dataset.fallback && i.src.indexOf(i.dataset.fallback) < 0) i.src = i.dataset.fallback;
    }, true);
})();
// Phones: tables whose first row holds only headers become one card per row
// (CSS in site.css, .rtable); each cell is labelled with its column name.
document.querySelectorAll('main table').forEach(function (t) {
    var head = t.rows[0];
    if (!head || t.classList.contains('no-rtable')) return;
    var ths = Array.prototype.slice.call(head.cells);
    if (!ths.length || ths.some(function (c) { return c.tagName !== 'TH'; })) return;
    t.classList.add('rtable');
    head.classList.add('rhead');
    var labels = ths.map(function (c) { return c.textContent.trim(); });
    Array.prototype.slice.call(t.rows, 1).forEach(function (r) {
        if (r.cells.length !== labels.length) { r.classList.add('rsub'); return; }
        Array.prototype.forEach.call(r.cells, function (c, i) {
            if (labels[i]) c.setAttribute('data-label', labels[i]);
            if (i === 0) c.classList.add('rtitle');
            else if (c.textContent.trim().length > 32 || c.querySelector('textarea, input, select, details, table, ul')) c.classList.add('rblock');
            if (!labels[i] || (i === labels.length - 1 && c.querySelector('form, a.btn, button'))) c.classList.add('actions');
        });
    });
});
</script>
</body>
</html>
