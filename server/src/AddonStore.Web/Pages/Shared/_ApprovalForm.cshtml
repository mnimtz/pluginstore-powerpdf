@* Approval with the store's approval conditions (S1.0.10): every condition must be
   ticked; the server checks it again and records the confirmed ids. Model: (version id,
   name of the hidden id field, page route id or null, button label key, private add-on).
   A private add-on never enters the public catalog: approving only documents a review
   (S1.4.0), so the form says so. S1.6.0: a public version is approved for beta or for live;
   one already approved for beta (Promote) only offers live. *@
@model (int VersionId, string IdField, string? RouteId, string Label, bool Private, bool Promote)
@{
    var conditions = AddonStore.Web.Validation.RuleCatalog.ApprovalConditions();
}
<details class="approve-box">
    <summary class="btn small">@L[Model.Label]</summary>
    <form method="post" asp-page-handler="Approve" asp-route-id="@Model.RouteId" class="stack" style="max-width:none;margin-top:8px">
        <input type="hidden" name="@Model.IdField" value="@Model.VersionId" />
        @if (Model.Private)
        {
            <p style="margin:0;font-size:.88rem;color:var(--tun-slate)">@L["Private add-on: it never appears in the public catalog. Approving only documents your review; customer deliveries hand out the newest checked version either way."]</p>
        }
        <p style="margin:0;font-size:.88rem;color:var(--tun-slate)">@L["Confirm every approval condition:"]</p>
        @foreach (var c in conditions)
        {
            <label style="display:flex;gap:8px;align-items:flex-start;font-weight:400">
                <input type="checkbox" name="confirmed" value="@c.Id" required style="width:auto;margin-top:3px" />
                <span><code>@c.Id</code> @c.Text</span>
            </label>
        }
        <div style="display:flex;gap:8px;flex-wrap:wrap;align-items:center">
            @if (Model.Private)
            {
                <button type="submit" name="stage" value="live" class="btn small">@L["Record the review"]</button>
            }
            else
            {
                @if (!Model.Promote)
                {
                    <button type="submit" name="stage" value="beta" class="btn small secondary"
                            title="@L["Workstations with the beta option get it; the live store keeps its current version."]">@L["Approve for beta"]</button>
                }
                <button type="submit" name="stage" value="live" class="btn small" title="@L["Every workstation gets it."]">@L["Approve for live store"]</button>
            }
            <a href="/Admin/Rules" style="font-size:.85rem;margin-left:8px">@L["Mandatory conditions"] →</a></div>
    </form>
</details>
