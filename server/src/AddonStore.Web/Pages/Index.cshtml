@page
@model AddonStore.Web.Pages.IndexModel
@{
    ViewData["Title"] = "";   // start page: the full site name is the title
}

<div class="hero">
    <h1>@L["Add-on Store for Tungsten Power PDF"]</h1>
    <p class="desktop-only">@L["Browse released plugins below. Installation happens directly inside Power PDF via the Add-on Store ribbon; this site is for plugin developers and admins."]</p>
    <p class="mobile-only">@L["Released add-ons for Tungsten Power PDF. They are installed on a Windows PC, directly inside Power PDF."]</p>
    @if (Model.ClientDownloadUrl is not null)
    {
        <div class="desktop-only" style="margin-top:16px;display:flex;gap:14px;align-items:center;flex-wrap:wrap">
            <span class="tip" id="dl-tip">
                <a class="btn cta" id="dl-btn" href="@Model.ClientDownloadUrl" aria-describedby="dl-tip-text">@L["Download"]: Add-on Store @L["for Power PDF"] v@(Model.ClientVersion)</a>
                <button type="button" class="tip-icon" aria-label="@L["Windows warning?"]" aria-describedby="dl-tip-text">i</button>
                <span class="tip-bubble" id="dl-tip-text" role="tooltip">
                    <b>@L["Windows warning?"]</b>
                    @L["The installer is not yet widely known, so Windows may show “Windows protected your PC”. Click “More info”, then “Run anyway”. This happens only once: updates and plug-ins are installed from within Power PDF."]
                </span>
            </span>
            <span style="color:var(--tun-blue-light);font-size:.85rem;max-width:460px">@L["Download and run the installer (administrator rights required); afterwards the add-on keeps itself and your plugins up to date."]</span>
        </div>
        <script nonce="@ViewContext.HttpContext.Items["CspNonce"]">
            // The Windows warning appears right after the download: show the hint for a while.
            (function () {
                var tip = document.getElementById('dl-tip'), btn = document.getElementById('dl-btn');
                if (!tip || !btn) return;
                btn.addEventListener('click', function () {
                    tip.classList.add('open');
                    setTimeout(function () { tip.classList.remove('open'); }, 20000);
                });
                document.addEventListener('click', function (e) {
                    if (!tip.contains(e.target)) tip.classList.remove('open');
                });
            })();
        </script>
    }
</div>

<div class="alert warn" style="font-size:.88rem">
    <span class="desktop-only-inline">@L["Plugins from independent authors, not official Tungsten Automation products: provided as is, without warranty or official support. Use at your own risk; Tungsten Automation accepts no liability."]</span>
    <span class="mobile-only-inline">@L["Add-ons from independent authors, without warranty or official support."]</span>
    <a href="/Disclaimer">@L["Disclaimer"]</a>
</div>

<h2>@L["Released plugins"]</h2>
@if (Model.Items.Count == 0)
{
    <div class="card">@L["No plugins have been released yet."]</div>
}
else
{
    <div class="catalog-tools">
        <input type="search" id="pkg-search" placeholder="@L["Search"]…" aria-label="@L["Search"]" />
        @if (Model.AiSearch)
        {
            <button type="button" class="btn small secondary" id="ai-ask" title="@L["Describe what you want to do; AI suggests matching add-ons."]">@L["Ask AI"]</button>
        }
        <div class="chips" id="pkg-chips">
            <button class="chip active" data-cat="">@L["All"]</button>
            @foreach (var cat in Model.Items.GroupBy(i => i.Category).Select(g => g.First()).OrderBy(i => i.CategoryName))
            {
                <button class="chip" data-cat="@cat.Category">@cat.CategoryName</button>
            }
        </div>
    </div>
    @if (Model.AiSearch)
    {
        <div class="card ai-box ai-results" id="ai-results" hidden>
            <div class="ai-head"><b>@L["AI suggestions"]</b> <span class="muted small" id="ai-status"></span></div>
            <ul id="ai-list"></ul>
            <p class="muted small">@L["Suggested by AI from the add-on descriptions; please check the details."]</p>
        </div>
    }
    <div class="grid" id="pkg-grid">
        @foreach (var item in Model.Items)
        {
            <div class="card pkg" data-cat="@item.Category" data-id="@item.Id"
                 data-text="@(item.Name.ToLowerInvariant()) @(item.Id) @(item.Description.ToLowerInvariant()) @(item.Author.ToLowerInvariant())">
                <span class="name">@item.Name</span>
                <partial name="_Stars" model="(item.Rating, item.RatingCount)" />
                <span class="meta">
                    <span class="badge live" style="font-weight:500">@item.CategoryName</span>
                    @item.Id · v@(item.Version) · @(item.SizeBytes / 1024) KB · @item.Downloads @L["download(s)"]
                </span>
                <span class="desc">@item.Description</span>
                <span class="meta">@L["Author"]: @item.Author
                    @if (!string.IsNullOrEmpty(item.ContactEmail))
                    {
                        <text> · </text><a href="mailto:@item.ContactEmail" style="color:var(--tun-blue)">@item.ContactEmail</a>
                    }
                </span>
                <span class="pkg-actions">
                    <a class="btn small win-only" href="addonstore://install/@item.Id"
                       title="@L["Opens Power PDF with this add-on selected and asks before installing. Requires the Add-on Store for Power PDF (version 0.3.7 or later)."]">@L["Install in Power PDF"]</a>
                    <a class="btn small secondary share-link" href="/a/@Model.Slugs[item.Id]"
                       title="@L["Own page of this add-on with a link to send to customers"]">@L["Share link"]</a>
                    <span class="client-hint" hidden>
                        @L["Nothing happened? This button needs the Add-on Store for Power PDF, version 0.3.7 or later, on this computer. Install it once (or update it in the store dialog), then click the button again."]
                        @if (Model.ClientDownloadUrl is not null)
                        {
                            <a href="@Model.ClientDownloadUrl">@L["Download the Add-on Store"]</a>
                        }
                    </span>
                </span>
            </div>
        }
    </div>
    <script nonce="@ViewContext.HttpContext.Items["CspNonce"]">
        (function () {
            var search = document.getElementById('pkg-search');
            var chips = document.querySelectorAll('#pkg-chips .chip');
            var cards = document.querySelectorAll('#pkg-grid .pkg');
            var cat = '';
            // Without a registered addonstore:// handler the browser does nothing.
            // When Power PDF or the "Open Add-on Store?" prompt appears, the page
            // loses focus; if it keeps focus, show how to get the client.
            document.querySelectorAll('.pkg-actions a.btn:not(.share-link)').forEach(function (a) {
                a.addEventListener('click', function () {
                    var hint = a.parentNode.querySelector('.client-hint');
                    var left = false;
                    function gone() { left = true; }
                    window.addEventListener('blur', gone);
                    document.addEventListener('visibilitychange', gone);
                    setTimeout(function () {
                        window.removeEventListener('blur', gone);
                        document.removeEventListener('visibilitychange', gone);
                        if (!left && hint) hint.hidden = false;
                    }, 1800);
                });
            });
            function apply() {
                var q = search.value.toLowerCase();
                cards.forEach(function (c) {
                    var hit = (!cat || c.dataset.cat === cat) &&
                              (!q || c.dataset.text.indexOf(q) >= 0);
                    c.style.display = hit ? '' : 'none';
                });
            }
            search.addEventListener('input', apply);
            var ask = document.getElementById('ai-ask');
            if (ask) {
                var box = document.getElementById('ai-results'), list = document.getElementById('ai-list'),
                    status = document.getElementById('ai-status');
                var slugs = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Slugs));
                function run() {
                    var q = search.value.trim();
                    if (q.length < 2) { search.focus(); return; }
                    box.hidden = false; list.innerHTML = ''; status.textContent = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["Searching…"].Value));
                    fetch('/api/search?q=' + encodeURIComponent(q) + '&lang=' + encodeURIComponent(document.documentElement.lang || 'en'))
                        .then(function (r) { return r.json(); })
                        .then(function (j) {
                            var res = (j.ok && j.data && j.data.results) || [];
                            status.textContent = res.length ? '' : @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["Nothing suitable found."].Value));
                            res.forEach(function (h) {
                                var li = document.createElement('li'), a = document.createElement('a');
                                a.href = slugs[h.id] ? '/a/' + slugs[h.id] : '#';
                                a.textContent = h.name;
                                li.appendChild(a);
                                if (h.reason) li.appendChild(document.createTextNode(': ' + h.reason));
                                list.appendChild(li);
                            });
                        })
                        .catch(function () { status.textContent = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["The search is not available right now."].Value)); });
                }
                ask.addEventListener('click', run);
                search.addEventListener('keydown', function (e) { if (e.key === 'Enter') run(); });
            }
            chips.forEach(function (chip) {
                chip.addEventListener('click', function () {
                    chips.forEach(function (x) { x.classList.remove('active'); });
                    chip.classList.add('active');
                    cat = chip.dataset.cat;
                    apply();
                });
            });
        })();
    </script>
}
