@page
@model AddonStore.Web.Pages.DeveloperModel
@{
    ViewData["Title"] = "API";
    var b = Model.BaseUrl;
}

<h1>@L["API and AI assistants"]</h1>
<p class="lead">@L["Publish and update plugins directly from your AI assistant, for example Claude, ChatGPT, Gemini or Copilot. The assistant reads the store's rules from the API, validates the package until all checks pass and submits it for review."]</p>

<div class="card">
    <h2 style="margin-top:0">1. @L["Create a personal token"]</h2>
    <p>@L["Create a token on your profile page and store it as an environment variable, never in a chat or a file:"]</p>
    <pre class="code">setx PPAK_TOKEN "ppak_..."</pre>
    <p style="font-size:.88rem;color:var(--tun-slate)">@L["Open a new terminal afterwards so the variable is available."] <a href="/Profile">@L["Profile"]</a></p>
</div>

<div class="card">
    <h2 style="margin-top:0">2. @L["Give your AI assistant one line"]</h2>
    <pre class="code">Read @(b)/agent-guide and publish the plugin in this folder.</pre>
    <p>@L["That is all it needs: it reads the guide, sets itself up for future sessions and follows the rules."]</p>
    <p style="margin-bottom:6px"><b>@L["Without access to the store (for example a cloud sandbox) or without a token:"]</b></p>
    <pre class="code">Read @(b)/agent-guide and build a manual upload package for the plugin in this folder.</pre>
    <p style="font-size:.88rem;color:var(--tun-slate)">@L["Upload the ZIP it hands you under Plug-ins, \"Submit a package\": the store submits the package and stores the source code in one step."]</p>
</div>

<details class="card">
    <summary style="cursor:pointer;font-weight:700;color:var(--tun-navy)">@L["Optional: set up your tool once"]</summary>
    <h3>AGENTS.md</h3>
    <p>@L["Coding assistants that read AGENTS.md (OpenAI Codex, GitHub Copilot, Cursor, Gemini CLI): save it in the plugin project."]</p>
    <pre class="code">Invoke-WebRequest @(b)/api/agents-md -OutFile AGENTS.md</pre>
    <p><a class="btn small secondary" href="/api/agents-md?download=1">@L["Download AGENTS.md"]</a></p>
    <h3>OpenAPI</h3>
    <p>@L["ChatGPT (custom GPT actions), Gemini function calling and other tools: import the OpenAPI description and enter the personal token as Bearer key."]</p>
    <pre class="code">@(b)/api/openapi.json</pre>
    <h3>Claude Code</h3>
    <p>@L["Claude Code: install the skill. It always loads the current rules from the server, so it never needs updating."]</p>
    <pre class="code">New-Item -ItemType Directory -Force "$env:USERPROFILE\.claude\skills\powerpdf-plugin-store" | Out-Null
Invoke-WebRequest @(b)/api/skill -OutFile "$env:USERPROFILE\.claude\skills\powerpdf-plugin-store\SKILL.md"</pre>
    <p><a class="btn small secondary" href="/api/skill?download=1">@L["Download SKILL.md"]</a></p>
</details>

<div class="card">
    <h2 style="margin-top:0">@L["Rules every upload must meet"]</h2>
    <ul>
        <li>@L["A new, higher version number (SemVer) for every upload, and a change description."]</li>
        <li>@L["Description and change description in all 16 European languages."]</li>
        <li>@L["An x64 build of the plugin (it also runs on Windows on ARM)."]</li>
        <li>@L["The plugin's buttons sit as a group on the shared “Enhanced Features” ribbon tab."]</li>
        <li>@L["Only third-party components under MIT, BSD or Apache-2.0."]</li>
    </ul>
    <p style="font-size:.88rem;color:var(--tun-slate)">@L["The automatic checks verify these rules; every finding comes with a concrete fix."]</p>
</div>

<div class="card">
    <h2 style="margin-top:0">@L["Endpoints"]</h2>
    <table>
        <tr><th>@L["Address"]</th><th>@L["Purpose"]</th></tr>
        <tr><td><code>@b/agent-guide</code></td><td>@L["Complete guide for developers and AI assistants"] (HTML)</td></tr>
        <tr><td><code>@b/api/agent-guide</code></td><td>@L["Complete guide for developers and AI assistants"] (Markdown)</td></tr>
        <tr><td><code>@b/api/openapi.json</code></td><td>@L["Description of all endpoints (OpenAPI 3.1)"]</td></tr>
        <tr><td><code>@b/llms.txt</code></td><td>@L["Short index for language models"]</td></tr>
        <tr><td><code>@b/api/schema/manifest</code></td><td>@L["Schema of manifest.json"]</td></tr>
        <tr><td><code>@b/api/tools/make-ppak.ps1</code></td><td>@L["Offline packer: .ppak, source ZIP and upload package"]</td></tr>
        <tr><td><code>@b/api</code></td><td>@L["List of all endpoints"]</td></tr>
        <tr><td><code>GET @b/api/me</code></td><td>@L["Check your token"]</td></tr>
        <tr><td><code>POST @b/api/packages/validate</code></td><td>@L["Test run of all checks, nothing is stored"]</td></tr>
        <tr><td><code>POST @b/api/packages</code></td><td>@L["Submit a package"]</td></tr>
        <tr><td><code>GET @b/api/packages/{id}</code></td><td>@L["Status, history and check reports of a package"]</td></tr>
        <tr><td><code>PATCH @b/api/packages/{id}</code></td><td>@L["Change name, description, author and contact without a new version"]</td></tr>
        <tr><td><code>PUT @b/api/packages/{id}/{version}/source</code></td><td>@L["Upload the source code of a version (after every upload)"]</td></tr>
        <tr><td><code>GET @b/api/packages/{id}/source/latest</code></td><td>@L["Admins: source code of the newest version, the starting point for a change"]</td></tr>
    </table>
</div>

<div class="card">
    <h2 style="margin-top:0">@L["Example with curl"]</h2>
    <pre class="code">curl -X POST -H "Authorization: Bearer %PPAK_TOKEN%" -H "Content-Type: application/zip" ^
     --data-binary @@my-plugin.ppak @(b)/api/packages/validate</pre>
</div>
