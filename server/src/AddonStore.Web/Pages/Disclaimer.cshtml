@page
@inject AddonStore.Web.Services.SettingsService ModeSettings
@inject IConfiguration ModeConfig
@{
    ViewData["PublicPage"] = true;   // public: always the classic layout (S1.5.0)
    ViewData["Title"] = "Disclaimer";
    var isBeta = await AddonStore.Web.Services.ServerMode.GetAsync(ModeSettings, ModeConfig) == AddonStore.Web.Services.ServerMode.Beta;
}

<h1>@L["Disclaimer"]</h1>

@* S2.4.0: only in beta mode; the general provisions below stay word for word the same *@
@if (isBeta)
{
    <section class="card beta-card" id="beta" aria-labelledby="beta-title">
        <h2 id="beta-title"><partial name="_ModeBadge" model='("beta", true)' /> @L["Beta phase"]</h2>
        <p>@L["The Add-on Store and its catalog are being trialled (beta)."]</p>
        <ul>
            <li>@L["Features, content and procedures may change or be discontinued at any time."]</li>
            <li>@L["Errors, interruptions and outages are possible; no availability is guaranteed."]</li>
            <li>@L["Data, settings and accounts from the beta phase may be reset or not carried over."]</li>
            <li>@L["Please do not use the beta for time-critical or business-critical processes, and keep backups of important documents."]</li>
            <li>@L["Feedback on errors is welcome: use the report function in the store window of Power PDF or contact the author named in the catalog."]</li>
        </ul>
        <p>@L["All other provisions of this disclaimer apply unchanged."]</p>
    </section>
}

<div class="card" style="max-width:820px;line-height:1.55">
    <p>@L["The plugins in this store are developed by independent authors, such as employees, partners or other developers. They are not part of Tungsten Power PDF and are not official Tungsten Automation products; the automatic checks and the review before release do not constitute a warranty."]</p>
    <p>@L["They are provided as is, without warranty of any kind, express or implied, including fitness for a particular purpose, availability or freedom from errors."]</p>
    <p>@L["There is no official support through Tungsten Automation Support. Please contact the author named in the catalog; answers are voluntary and without guaranteed response times."]</p>
    <p>@L["To the extent permitted by law, Tungsten Automation accepts no liability for damage, data loss or downtime caused by installing or using these plugins. Each plugin is the responsibility of its author."]</p>
    <p>@L["Test plugins before productive use, keep backups of important documents, and make sure their use complies with your organization's IT and data protection policies."]</p>
</div>
