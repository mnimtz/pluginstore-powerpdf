@page
@using System.Text.Json
@using AddonStore.Web.Validation
@model AddonStore.Web.Pages.Admin.ReviewModel
@{
    ViewData["Title"] = "Review";
}

<h1>@L["Review queue"]</h1>
<p class="lead">@L["Beta versions passed all automatic checks and are visible to beta testers. Approve them for the live store or reject them with a reason."]</p>

@if (Model.Notice is not null)
{
    <div class="alert ok">@L[Model.Notice]</div>
}

@{
    var toCheck = RuleCatalog.House.Rules.Where(h => h.Kind == "review").ToList();
}
@if (toCheck.Count > 0)
{
    <div class="card" style="border-left:4px solid var(--tun-blue);margin-bottom:14px">
        <strong>@L["House rules to check before approval"]</strong>
        <ul style="margin:6px 0 0">
            @foreach (var h in toCheck) { <li><b>@h.Title</b>: @h.Text</li> }
        </ul>
        <p style="margin:6px 0 0;font-size:.85rem"><a href="/Admin/Rules?area=store">@L["Rules of this store"] →</a></p>
    </div>
}
@if (Model.Queue.Count == 0)
{
    <div class="card">@L["Nothing to review right now."]</div>
}
@foreach (var v in Model.Queue)
{
    <div class="card">
        @{
            var lang = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
        }
        <strong style="color:var(--tun-navy)"><a href="/Plugin?id=@v.PackageId">@(Model.Packages.TryGetValue(v.PackageId, out var rp) ? AddonStore.Web.Services.CatalogUi.DisplayName(rp, v, lang) : AddonStore.Web.Services.CatalogUi.ManifestText(v, "name", lang, v.PackageId))</a></strong>
        <span style="color:var(--tun-slate)">@v.PackageId</span> v@(v.Version)
        <span class="badge beta">@L["Beta"]</span>
        <div style="color:var(--tun-slate);font-size:.85rem;margin:4px 0 8px">
            @L["Submitted by"] @v.SubmittedBy · @v.SubmittedVia · @Time.Fmt(v.SubmittedAt) · @(v.SizeBytes / 1024) KB · SHA-256 <code>@v.Sha256[..16]…</code>
        </div>
        <p style="margin:6px 0"><b>@L["Changelog"]:</b> @AddonStore.Web.Services.CatalogUi.ManifestText(v, "changelog", lang, v.Changelog)</p>
        <partial name="_ValidationReport" model="AddonStore.Web.Validation.ReportView.Parse(v.ValidationReportJson)"
                 view-data="@(new Microsoft.AspNetCore.Mvc.ViewFeatures.ViewDataDictionary(ViewData) { ["open"] = true })" />
        @if ((Model.AiReviewOn || v.AiReviewJson is not null) && v.PackageId != "com.tungsten.pluginstore")
        {
            <partial name="_AiReview" model="(v, Model.AiReviewOn)" />
        }
        <div style="display:flex;gap:10px;align-items:flex-start;margin-top:10px;flex-wrap:wrap">
            <a class="btn small secondary" href="/api/packages/@v.PackageId/@v.Version/download">@L["Download"]</a>
            <partial name="_ApprovalForm" model='(v.Id, "id", (string?)null, "Approve for live store")' />
            <form method="post" asp-page-handler="Reject" style="display:flex;gap:8px;flex:1;min-width:280px">
                <input type="hidden" name="id" value="@v.Id" />
                <input type="text" name="comment" placeholder="@L["Reason (sent to the submitter)"]" required style="flex:1" />
                <button type="submit" class="btn small danger">@L["Reject"]</button>
            </form>
        </div>
    </div>
}

<div class="card" style="display:flex;gap:12px;align-items:center;flex-wrap:wrap">
    <span>@L["Live plug-ins, older versions, withdrawing and restoring: see the plug-in overview."]</span>
    <a class="btn small" href="/Dashboard?filter=live">@L["Open plug-in overview"]</a>
</div>
