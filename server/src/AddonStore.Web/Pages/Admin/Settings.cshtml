@page
@model AddonStore.Web.Pages.Admin.SettingsModel
@{
    ViewData["Title"] = "Settings";
}

<h1>@L["Settings"]</h1>
@if (Model.SigningProblem is not null)
{
    <div class="alert error">@L["The package signing key cannot be read. Clients refuse installs until the backup is restored with its key ring password or the App Setting Signing__PrivateKeyPem holds the recovery key."]</div>
}
else if (Model.SigningKeyId.Length > 0)
{
    <p style="font-size:.82rem;color:var(--tun-slate)">@L["Package signing key"]: <code>@Model.SigningKeyId</code></p>
}
<p class="lead">@L["Instance settings; values are stored on the server and take effect immediately."]</p>

<div class="report-layout">
<nav class="report-nav" aria-label="@L["Sections"]">
    @foreach (var (key, label) in AddonStore.Web.Pages.Admin.SettingsModel.Views)
    {
        <a href="@Url.Page("/Admin/Settings", new { view = key == "server" ? null : key })" class="@(Model.View == key ? "active" : "")" aria-current="@(Model.View == key ? "page" : null)">@L[label]</a>
    }
    <a href="/Admin/Backup">@L["Backup and restore"] →</a>
    <a href="/Admin/Categories">@L["Categories"] →</a>
    <a href="/Admin/Rules">@L["Rules"] →</a>
    <a href="/Docs">@L["Documentation"] →</a>
</nav>
<div class="report-main">

@if (Model.Notice is not null)
{
    <div class="alert @Model.NoticeKind">@L[Model.Notice]
        @if (Model.TestDetail is not null)
        {
            <br /><code>@Model.TestDetail</code>
        }
    </div>
}

@if (Model.View == "email")
{
<div class="card" style="max-width:560px">
    <h2 style="margin-top:0">@L["Email notifications (Resend)"]</h2>
    <form method="post" asp-page-handler="Email" class="stack" style="max-width:none">
        <div>
            <label>@L["Resend API key"]</label>
            <input type="password" name="resendKey" placeholder="@(Model.HasResendKey ? "••••••••  (" + L["configured"] + ")" : "re_...")" autocomplete="off" />
        </div>
        <div>
            <label>@L["Sender address"]</label>
            <input type="text" name="from" value="@Model.From" placeholder="Add-on Store &lt;store@yourdomain.com&gt;" />
        </div>
        <button type="submit" class="btn cta">@L["Save"]</button>
    </form>
    <form method="post" asp-page-handler="TestMail" style="margin-top:12px;display:flex;gap:8px;flex-wrap:wrap;align-items:center">
        <label for="testTo" style="margin:0">@L["Recipient"]</label>
        <input type="email" id="testTo" name="testTo" value="@(Model.TestTo ?? Model.MyEmail)" required maxlength="200" style="flex:1;min-width:220px;max-width:340px" />
        <button type="submit" class="btn small secondary">@L["Send test email"]</button>
    </form>
    <p style="font-size:.82rem;color:var(--tun-slate)">@L["Without a verified sender domain, Resend only delivers to the email address of the Resend account owner."]</p>
</div>
}

<style>.ppline input:not([type=checkbox]):not([type=hidden]), .ppline select { width: 100%; box-sizing: border-box; }</style>
@if (Model.View == "updates")
{
<div class="card" style="max-width:900px" id="updates">
    <h2 style="margin-top:0">@L["Power PDF updates"]</h2>
    <p style="font-size:.88rem;color:var(--tun-slate)">@L["The server reads the Power PDF documentation once a day. When Tungsten publishes a newer update for a release line, the admins get an email, and store clients of that line show a hint with a link to the official ReadMe (only where the hint is switched on in the client options). Nothing is downloaded or installed in this stage."]</p>
    <form method="post" asp-page-handler="PpSettings" class="stack" style="max-width:none">
        <label style="display:flex;gap:8px;align-items:center;font-weight:600">
            <input type="checkbox" name="enabled" value="true" checked="@Model.PpOn" style="width:auto" />
            <span>@L["Manage Power PDF updates"]</span>
        </label>
        <div>
            <label for="ppov">@L["Overview page (finds new major versions)"]</label>
            <input id="ppov" name="overviewUrl" value="@Model.PpOverview" placeholder="@AddonStore.Web.Services.PowerPdfUpdateService.DefaultOverview" maxlength="500" style="width:100%" />
        </div>
        <div>
            <label for="pphosts">@L["Allowed hosts (comma separated)"]</label>
            <input id="pphosts" name="hosts" value="@Model.PpHosts" placeholder="@AddonStore.Web.Services.PowerPdfUpdateService.DefaultHosts" maxlength="500" style="width:100%" />
        </div>
        <div><button type="submit" class="btn cta">@L["Save"]</button></div>
    </form>
</div>

@if (Model.PpOn)
{
<div class="card" style="max-width:900px">
    <div style="display:flex;gap:12px;align-items:center;flex-wrap:wrap;justify-content:space-between">
        <h3 style="margin:0">@L["Release lines"]</h3>
        <form method="post" asp-page-handler="PpCheck"><button type="submit" class="btn small">@L["Check now"]</button></form>
    </div>
    @{ var watched = Model.PpLines.Where(l => l.Status is "maintained" or "security" or "suggested").ToList(); }
    @if (watched.Count > 0)
    {
        <div class="lead-box" style="margin:10px 0">
            <b>@L["Detected as current"]</b>
            <div class="table-wrap"><table style="margin-top:6px">
                <tr><th>@L["Line"]</th><th>@L["Newest update"]</th><th>@L["Build date"]</th><th>@L["Detected"]</th><th>@L["Last check"]</th><th></th></tr>
                @foreach (var w in watched)
                {
                    <tr>
                        <td>@w.Title @if (w.Status == "suggested") { <br /><span class="badge beta">@L["Preview"]</span> <span class="small muted">@L["Clients get no hint until the line is maintained."]</span> }</td>
                        <td>@if (w.LatestVersion is null) { <span class="muted">@L["not found yet"]</span> } else { <b>@w.LatestVersion</b><br /><span class="small muted">@w.LatestTitle</span> }</td>
                        <td>@(w.LatestBuildDate ?? "-")</td>
                        <td>@(w.DetectedAt is { } wd ? Time.Fmt(wd) : "-")</td>
                        <td>@(w.LastCheckAt is { } wc ? Time.Fmt(wc) : "-") @if (w.LastCheckResult is { } wr && wr != "ok") { <br /><span class="small" style="color:var(--tun-coral)">@wr</span> }</td>
                        <td>@if (w.LatestReadmeUrl is not null) { <a href="@w.LatestReadmeUrl" target="_blank" rel="noopener noreferrer">ReadMe</a> }</td>
                    </tr>
                }
            </table></div>
            <form method="post" asp-page-handler="PpProbe" style="display:flex;gap:8px;align-items:flex-end;flex-wrap:wrap;margin-top:10px">
                <div style="flex:1;min-width:220px"><label for="ppprobe">@L["How a client sees it: Power PDF version"]</label>
                    <input id="ppprobe" name="version" value="@Model.PpProbeVersion" placeholder="2025.3.8.0.26414" maxlength="40" style="width:100%" /></div>
                <button type="submit" class="btn small secondary">@L["Check"]</button>
            </form>
            @if (Model.PpProbeKey is not null)
            {
                <p style="margin:8px 0 0"><b>@L[Model.PpProbeKey, Model.PpProbeArgs]</b></p>
            }
        </div>
    }
    <p class="small muted" style="margin:6px 0 10px">@L["Last check"]: @(DateTime.TryParse(Model.PpLastRun, System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.RoundtripKind, out var plr) ? Time.Fmt(plr) : "-")
        @if (Model.PpLastResult.Length > 0 && Model.PpLastResult != "ok") { <span> · </span><span style="color:var(--tun-coral)">@Model.PpLastResult</span> }</p>
    @if (Model.PpLines.Count == 0)
    {
        <p class="muted">@L["No release line yet. \"Check now\" proposes the current version from the overview page, or add one below."]</p>
    }
    @foreach (var ln in Model.PpLines)
    {
        <details class="card" style="margin:8px 0;padding:10px 14px" open="@(ln.Status == "suggested")">
            <summary style="cursor:pointer;display:flex;gap:10px;align-items:center;flex-wrap:wrap">
                <b>@ln.Title</b>
                <span class="badge @(ln.Status switch { "suggested" => "beta", "maintained" => "live", "security" => "submitted", _ => "withdrawn" })">@L[ln.Status switch { "suggested" => "Suggested", "maintained" => "Maintained", "security" => "Security updates only", _ => "Line ended" }]</span>
                @if (ln.LatestVersion is not null) { <span class="small">@L["Newest update"]: <b>@ln.LatestVersion</b>@(ln.LatestBuildDate is null ? "" : " (" + ln.LatestBuildDate + ")")</span> }
                @if (ln.OwnUpdateManager) { <span class="badge submitted">@L["Own Update Manager"]</span> }
                @if (ln.LastCheckResult is { } lcr && lcr != "ok") { <span class="small" style="color:var(--tun-coral)">@lcr</span> }
            </summary>
            @if (ln.Status == "suggested")
            {
                <p class="small" style="margin:8px 0">@L["Found on the overview page. Check the address and set the status to \"Maintained\" to watch its updates."]</p>
            }
            @if (ln.LatestReadmeUrl is not null)
            {
                <p class="small" style="margin:8px 0"><a href="@ln.LatestReadmeUrl" target="_blank" rel="noopener noreferrer">ReadMe @ln.LatestVersion</a> · @L["Detected"]: @(ln.DetectedAt is { } da ? Time.Fmt(da) : "-")</p>
            }
            <form method="post" asp-page-handler="PpLine" class="stack ppline" style="max-width:none;margin-top:8px">
                <input type="hidden" name="id" value="@ln.Id" />
                <div style="display:grid;grid-template-columns:minmax(0,140px) minmax(0,1fr);gap:8px">
                    <div><label>@L["Line"]</label><input name="key" value="@ln.Key" required maxlength="10" /></div>
                    <div><label>@L["Name"]</label><input name="title" value="@ln.Title" maxlength="80" /></div>
                </div>
                <div><label>@L["Watched page"]</label><input name="watchUrl" value="@ln.WatchUrl" required maxlength="500" /></div>
                <div><label>@L["Pattern (group 1 = update version)"]</label><input name="pattern" value="@ln.Pattern" maxlength="300" style="font-family:Consolas,monospace" /></div>
                <div style="display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:8px">
                    <div><label>@L["Status"]</label>
                        <select name="status">
                            @foreach (var s in AddonStore.Web.Services.PowerPdfUpdateService.Statuses)
                            {
                                <option value="@s" selected="@(s == ln.Status)">@L[s switch { "suggested" => "Suggested", "maintained" => "Maintained", "security" => "Security updates only", _ => "Line ended" }]</option>
                            }
                        </select></div>
                    <div><label>@L["Support ends (optional)"]</label><input type="date" name="supportEnd" value="@ln.SupportEnd?.ToString("yyyy-MM-dd")" /></div>
                </div>
                <input type="hidden" name="ownUpdateManagerShown" value="1" />
                <label style="display:flex;gap:8px;align-items:center;font-weight:400">
                    <input type="checkbox" name="ownUpdateManager" value="true" checked="@ln.OwnUpdateManager" style="width:auto" />
                    <span>@L["Power PDF updates itself (own Update Manager, from 2026.4): no hint from the store"]</span>
                </label>
                <label style="display:flex;gap:8px;align-items:center;font-weight:400">
                    <input type="checkbox" name="majorHint" value="true" checked="@ln.OfferMajorHint" style="width:auto" />
                    <span>@L["Tell clients of this line about a newer major version (link only)"]</span>
                </label>
                <div style="display:flex;gap:8px;flex-wrap:wrap">
                    <button type="submit" class="btn small">@L["Save"]</button>
                </div>
            </form>
            <form method="post" asp-page-handler="PpLineDelete" data-confirm="@L["Delete this release line? Its clients get no hints any more."]" style="margin-top:6px">
                <input type="hidden" name="id" value="@ln.Id" />
                <button type="submit" class="btn small danger">@L["Delete"]</button>
            </form>
            @if (ln.LatestVersion is not null)
            {
                <div style="margin-top:12px;border-top:1px solid var(--tun-gray-200);padding-top:10px">
                    <b>@L["Text for end users"]</b>
                    <p class="small muted" style="margin:4px 0">@L["Shown with the hint in the store window. Without a text the hint shows the update and the ReadMe link only."]</p>
                    @{
                        var lang = AddonStore.Web.Services.Lang.Current;
                        string? Pick(string? json) { if (json is null) return null; try { var d = System.Text.Json.JsonSerializer.Deserialize<Dictionary<string, string>>(json); return d?.GetValueOrDefault(lang) ?? d?.GetValueOrDefault("en"); } catch (System.Text.Json.JsonException) { return null; } }
                        var current = Pick(ln.SummaryJson); var draft = Pick(ln.SummaryDraftJson);
                    }
                    @if (current is not null) { <p style="margin:6px 0"><span class="badge live">@L["Active"]</span> @current</p> }
                    @if (draft is not null)
                    {
                        <p style="margin:6px 0"><span class="badge beta">@L["Proposal"]</span> @draft</p>
                        <div style="display:flex;gap:8px;flex-wrap:wrap">
                            <form method="post" asp-page-handler="PpSummary"><input type="hidden" name="id" value="@ln.Id" /><input type="hidden" name="act" value="accept" /><button type="submit" class="btn small">@L["Accept the text"]</button></form>
                            <form method="post" asp-page-handler="PpSummary"><input type="hidden" name="id" value="@ln.Id" /><input type="hidden" name="act" value="discard" /><button type="submit" class="btn small secondary">@L["Discard"]</button></form>
                        </div>
                    }
                    else
                    {
                        <div style="display:flex;gap:8px;flex-wrap:wrap;margin-top:6px">
                            <form method="post" asp-page-handler="PpSummary"><input type="hidden" name="id" value="@ln.Id" /><button type="submit" class="btn small secondary" disabled="@(!Model.Ai.On)" title="@(Model.Ai.On ? "" : L["The AI assistant is switched off (Settings, AI assistant)."].Value)">@L["Propose a text (AI, 21 languages)"]</button></form>
                            @if (current is not null)
                            {
                                <form method="post" asp-page-handler="PpSummary"><input type="hidden" name="id" value="@ln.Id" /><input type="hidden" name="act" value="discard" /><input type="hidden" name="all" value="1" /><button type="submit" class="btn small secondary">@L["Remove the text"]</button></form>
                            }
                        </div>
                    }
                </div>
            }
        </details>
    }
    <details class="card" style="margin:8px 0;padding:10px 14px">
        <summary style="cursor:pointer"><b>@L["Add a release line"]</b></summary>
        <form method="post" asp-page-handler="PpLine" class="stack ppline" style="max-width:none;margin-top:8px">
            <div style="display:grid;grid-template-columns:minmax(0,140px) minmax(0,1fr);gap:8px">
                <div><label>@L["Line"]</label><input name="key" placeholder="2026.4" required maxlength="10" /></div>
                <div><label>@L["Name"]</label><input name="title" placeholder="Power PDF 2026.4" maxlength="80" /></div>
            </div>
            <div><label>@L["Watched page"]</label><input name="watchUrl" required maxlength="500" placeholder="https://docshield.tungstenautomation.com/Portal/Products/en_US/PowerPDF/…/PowerPDF.htm" /></div>
            <div><label>@L["Pattern (group 1 = update version)"]</label><input name="pattern" maxlength="300" placeholder="@L["empty = ReadMe link of this line"]" style="font-family:Consolas,monospace" /></div>
            <input type="hidden" name="status" value="maintained" />
            <div><button type="submit" class="btn small">@L["Add"]</button></div>
        </form>
    </details>
</div>
}
}

@if (Model.View == "store")
{
<div class="card" style="max-width:760px" id="store">
    <h2 style="margin-top:0">@L["Add-on Store"]</h2>
    <h3 style="margin-bottom:4px">@L["Allowed license modes"]</h3>
    <p style="font-size:.88rem;color:var(--tun-slate)">@L["Which Power PDF installations may use the store. For a mode that is off, the store button does not appear in Power PDF and no add-ons are offered; the store client can still update itself. Installed add-ons keep working. The store client reports the mode itself (from client 1.5.0), so this is a usage rule, not copy protection."]</p>
    <form method="post" asp-page-handler="StoreAccess">
        <div class="stack" style="max-width:none">
            @foreach (var (key, label) in AddonStore.Web.Services.StoreAccess.Modes)
            {
                <label style="display:flex;gap:8px;align-items:center;font-weight:400">
                    <input type="checkbox" name="modes" value="@key" checked="@Model.StoreModes.Contains(key)" style="width:auto" />
                    <span>@L[label]</span>
                </label>
            }
        </div>
        @if (Model.StoreModes.Count == 0)
        {
            <p class="alert error" style="margin-top:10px">@L["No license mode is allowed: the store is hidden in every Power PDF."]</p>
        }
        <button type="submit" class="btn cta" style="margin-top:12px">@L["Save"]</button>
    </form>
</div>
}

@if (Model.View == "notifications")
{
<div class="card" style="max-width:760px">
    <h2 style="margin-top:0">@L["Notifications"]</h2>
    <p style="font-size:.88rem;color:var(--tun-slate)">@L["Which emails are sent when, and to whom. Every sent or failed email is recorded in the audit log."]</p>
    <form method="post" asp-page-handler="Notifications">
        <div class="table-wrap"><table>
            <tr><th>@L["Active"]</th><th>@L["Event"]</th><th>@L["Recipients"]</th></tr>
            @foreach (var (key, label, recipients) in AddonStore.Web.Services.NotificationService.Events)
            {
                <tr>
                    <td><input type="checkbox" name="enabled" value="@key" checked="@Model.EventEnabled[key]" style="width:auto" /></td>
                    <td>@L[label]</td>
                    <td>@L[recipients]</td>
                </tr>
            }
            <tr>
                <td><input type="checkbox" checked disabled style="width:auto" /></td>
                <td>@L["Invitation"]</td>
                <td>@L["Invited person (always sent)"]</td>
            </tr>
        </table></div>
        <button type="submit" class="btn cta" style="margin-top:12px">@L["Save"]</button>
    </form>
</div>
}

@if (Model.View == "server")
{
<div class="card" style="max-width:560px">
    <h2 style="margin-top:0">@L["Server"]</h2>
    <form method="post" asp-page-handler="Server" class="stack" style="max-width:none">
        <div>
            <label>@L["Public base URL (used in emails and invite links)"]</label>
            <input type="text" name="baseUrl" value="@Model.BaseUrl" placeholder="https://addon.power-pdf.de" />
        </div>
        <div>
            <label>@L["Time zone for displayed times"]</label>
            <select name="timeZone">
                @foreach (var z in AddonStore.Web.Services.TimeDisplay.Zones)
                {
                    <option value="@z" selected="@(z == Model.TimeZone)">@z</option>
                }
            </select>
        </div>
        <div>
            <label>@L["Source code per version"]</label>
            <select name="sourcePolicy">
                <option value="required" selected="@(Model.SourcePolicy == "required")">@L["Required: no approval without source code"]</option>
                <option value="recommended" selected="@(Model.SourcePolicy == "recommended")">@L["Recommended: approval possible without source code"]</option>
                <option value="off" selected="@(Model.SourcePolicy == "off")">@L["Off"]</option>
            </select>
            <small style="color:var(--tun-slate)">@L["Source code is stored next to each version and visible to admins only; Power PDF clients never receive it."]</small>
        </div>
        <div>
            <label style="display:flex;gap:8px;align-items:center">
                <input type="checkbox" name="fourEyes" value="true" checked="@Model.FourEyes" style="width:auto" />
                @L["Four-eyes rule: nobody approves a version they uploaded or own"]
            </label>
            @if (Model.ApproverCount < 2)
            {
                <small style="color:var(--tun-slate)">@L["Needs at least two active admins or reviewers; with only one, own versions can no longer be approved."]</small>
            }
        </div>
        <button type="submit" class="btn cta">@L["Save"]</button>
    </form>
</div>
}

@if (Model.View == "ai")
{
<div class="card" style="max-width:760px" id="ai">
    <h2 style="margin-top:0">@L["AI assistant (optional)"]</h2>
    <p style="font-size:.88rem;color:var(--tun-slate)">@L["Sorts problem reports, prepares a review aid for new versions and lets users search for add-ons by describing what they need. Off by default; everything works without it."]</p>
    <h3>1. @L["Provider and key"]</h3>
    <form method="post" asp-page-handler="AiConnect" class="stack" style="max-width:none">
        <div>
            <label>@L["Provider"]</label>
            <select name="provider">
                <option value="off" selected="@(Model.Ai.Provider == "off")">@L["Off"]</option>
                <option value="claude" selected="@(Model.Ai.Provider == "claude")">Claude (Anthropic)</option>
                <option value="gemini" selected="@(Model.Ai.Provider == "gemini")">Gemini (Google)</option>
                @if (Model.OfferFake)
                {
                    <option value="fake" selected="@(Model.Ai.Provider == "fake")">Test (Development)</option>
                }
            </select>
        </div>
        <div>
            <label>@L["API key"]</label>
            <input type="password" name="apiKey" placeholder="@(Model.Ai.HasKey ? "••••••••  (" + L["configured"] + ")" : "")" autocomplete="off" />
            @if (Model.Ai.HasKey)
            {
                <label style="font-weight:400"><input type="checkbox" name="clearKey" value="true" style="width:auto" /> @L["Remove stored key"]</label>
            }
            <small style="color:var(--tun-slate)">@L["Stored encrypted on the server and never shown again. Use a key of your own organization with a spending limit."]</small>
        </div>
        <button type="submit" class="btn cta">@L["Connect and load models"]</button>
    </form>

    @if (Model.Ai.On)
    {
        <h3>2. @L["Model and features"]</h3>
        <form method="post" asp-page-handler="Ai" class="stack" style="max-width:none">
            <div>
                <label>@L["Model"]</label>
                @if (Model.AiModels.Count == 0)
                {
                    <p class="muted small">@L["No model list loaded yet: use \"Connect and load models\" above. Until then the default model is used."]</p>
                    <input type="hidden" name="model" value="" />
                }
                else
                {
                    <select name="model">
                        <option value="" selected="@(!Model.AiModels.Any(m => m.Id == Model.Ai.Model))">@L["Default"] (@(Model.Ai.Provider == "gemini" ? AddonStore.Web.Services.AiService.DefaultGeminiModel : AddonStore.Web.Services.AiService.DefaultClaudeModel))</option>
                        @foreach (var m in Model.AiModels)
                        {
                            <option value="@m.Id" selected="@(m.Id == Model.Ai.Model)">@m.Name (@m.Id)</option>
                        }
                    </select>
                    <small style="color:var(--tun-slate)">@L["Models this key may use, loaded live from the provider."]</small>
                }
            </div>
            <div>
                <label style="font-weight:400"><input type="checkbox" name="triage" value="true" checked="@Model.Ai.Triage" style="width:auto" /> @L["Sort problem reports (category, urgency, summary, reply draft, duplicates)"]</label>
                <label style="font-weight:400"><input type="checkbox" name="review" value="true" checked="@Model.Ai.Review" style="width:auto" /> @L["Review aid for new versions (on request)"]</label>
                <label style="font-weight:400;margin-left:24px"><input type="checkbox" name="reviewAuto" value="true" checked="@Model.Ai.ReviewAuto" style="width:auto" /> @L["Create automatically for every new version"]</label>
                <label style="font-weight:400;margin-left:24px"><input type="checkbox" name="reviewSource" value="true" checked="@Model.Ai.ReviewSource" style="width:auto" /> @L["Send changed source code lines to the provider"]</label>
                <label style="font-weight:400;margin-left:24px">@L["Language of automatic review aids"]
                    <select name="reviewLanguage" style="width:auto;margin-left:8px">
                        @foreach (var code in AddonStore.Web.Services.AiAssist.ReviewLanguages.Keys)
                        {
                            var ci = new System.Globalization.CultureInfo(code);
                            <option value="@code" selected="@(Model.Ai.ReviewLanguage == code)">@(char.ToUpper(ci.NativeName[0]) + ci.NativeName[1..])</option>
                        }
                    </select>
                </label>
                <label style="font-weight:400"><input type="checkbox" name="search" value="true" checked="@Model.Ai.Search" style="width:auto" /> @L["Search by need on the website and in the store window"]</label>
            </div>
            <div>
                <label>@L["Requests per day (limit)"]</label>
                <input type="number" name="dailyLimit" value="@Model.Ai.DailyLimit" min="1" max="100000" style="max-width:140px" />
            </div>
            <button type="submit" class="btn cta">@L["Save"]</button>
        </form>
        <h3>3. @L["Test"]</h3>
        <form method="post" asp-page-handler="AiTest">
            <button type="submit" class="btn small secondary">@L["Test connection"]</button>
            <small style="color:var(--tun-slate)">@L["Sends one short request with the chosen model."]</small>
        </form>
    }
    <p style="font-size:.82rem;color:var(--tun-slate)">@L["Data sent to the provider: add-on texts from the catalog, the text of problem reports, search queries, manifests and file lists of new versions, and only with the option above changed source code lines. Never sent: email addresses, IP addresses, log excerpts, user accounts. Check with your data protection team before switching it on."]</p>
</div>
}

@if (Model.View == "reset")
{
<div class="card" style="max-width:760px" id="reset">
    <h2 style="margin-top:0">@L["Reset statistics"]</h2>
    <p style="font-size:.88rem;color:var(--tun-slate)">@L["After internal tests: delete the collected statistics so the reports count from here on. Add-ons, versions, accounts, customers and the audit log stay. A safety backup of the whole store is written first."]</p>
    @if (Model.StatsResetAt is { } resetAt)
    {
        <p style="font-size:.88rem">@L["Last reset: {0}", Time.Fmt(resetAt)]</p>
    }
    <form method="post" asp-page-handler="Reset" class="stack" style="max-width:none"
          data-confirm="@L["Delete the chosen statistics now? This cannot be undone (except from the safety backup)."]">
        <label style="font-weight:400"><input type="checkbox" name="usage" value="true" checked style="width:auto" /> @L["Downloads and usage statistics ({0} rows, {1} downloads)", Model.StatUsageRows, Model.StatDownloads]</label>
        <label style="font-weight:400"><input type="checkbox" name="shares" value="true" checked style="width:auto" /> @L["Shared-link statistics ({0} rows)", Model.StatShareRows]</label>
        <label style="font-weight:400"><input type="checkbox" name="ipEvents" value="true" checked style="width:auto" /> @L["Stored IP addresses ({0} requests)", Model.IpEventCount]</label>
        <label style="font-weight:400"><input type="checkbox" name="ratings" value="true" style="width:auto" /> @L["Ratings ({0})", Model.StatRatings]</label>
        <label style="font-weight:400"><input type="checkbox" name="feedback" value="true" style="width:auto" /> @L["Problem reports and comments ({0})", Model.StatFeedback]</label>
        <div style="display:flex;gap:6px;align-items:center">
            <input name="confirm" placeholder="RESET" style="width:120px" autocomplete="off" />
            <button type="submit" class="btn small danger">@L["Reset statistics"]</button>
        </div>
    </form>
</div>
}

@if (Model.View == "privacy")
{
<div class="card" style="max-width:760px" id="inventory">
    <h2 style="margin-top:0">@L["Existing customers (evaluation)"]</h2>
    <p style="font-size:.88rem;color:var(--tun-slate)">@L["Store clients report once a day: the domain of the Cloud License Server sign-in (never the e-mail address), the license mode, the Power PDF and store versions and the installed add-ons. The company behind a domain is found automatically (portal customers, then the AI assistant) and can be corrected under Existing customers. Only the last state per installation is kept. Free-mail domains are not stored."]</p>
    @if (Model.InvConfirmedAt is { } invAt)
    {
        <p style="font-size:.88rem">@L["GDPR confirmation given by {0} on {1}.", Model.InvConfirmedBy, Time.Fmt(invAt)]</p>
    }
    @if (!Model.InvOn)
    {
        <form method="post" asp-page-handler="InvEnable">
            @if (Model.InvConfirmedAt is null)
            {
                <div class="alert warn">
                    <p style="margin-top:0"><b>@L["Data protection (GDPR)"]</b></p>
                    <p>@L["The evaluation links installations to companies. A company domain can point to a person (for example a sole trader), and the domains are sent to the AI provider set up under AI assistant. It needs a legal basis (for example legitimate interest), a note in the privacy policy or the terms of the store and a retention period. Please clarify this with your data protection officer before switching it on."]</p>
                    <label style="display:flex;gap:8px;align-items:flex-start">
                        <input type="checkbox" name="confirmInventory" value="true" required style="width:auto;margin-top:3px" />
                        <span>@L["I confirm that a legal basis exists, the users are informed (privacy policy or terms of the store) and the retention period below is agreed."]</span>
                    </label>
                </div>
            }
            <div>
                <label>@L["Retention period (days)"]</label>
                <input type="number" name="retentionDays" min="7" max="730" value="@Model.InvRetention" style="width:120px" />
            </div>
            <button type="submit" class="btn cta" style="margin-top:12px">@(Model.InvConfirmedAt is null ? L["Confirm and switch on"] : L["Switch on"])</button>
        </form>
    }
    else
    {
        <p><span class="badge live">@L["On"]</span> @L["Installations: {0}. Not seen for {1} days: deleted automatically.", Model.InvInstalls, Model.InvRetention]
           · <a href="/Admin/Inventory">@L["Existing customers"] →</a></p>
        <form method="post" asp-page-handler="InvEnable" style="display:flex;gap:6px;align-items:flex-end;flex-wrap:wrap;margin-bottom:10px">
            <div><label>@L["Retention period (days)"]</label>
            <input type="number" name="retentionDays" min="7" max="730" value="@Model.InvRetention" style="width:100px" /></div>
            <button type="submit" class="btn small secondary">@L["Save retention period"]</button>
        </form>
        <form method="post" asp-page-handler="InvDisable" style="display:flex;gap:10px;align-items:center;flex-wrap:wrap"
              data-confirm="@L["Switch the existing-customer evaluation off?"]">
            <label style="display:flex;gap:6px;align-items:center;font-weight:400;margin:0">
                <input type="checkbox" name="deleteData" value="true" style="width:auto" /> <span>@L["Also delete all stored data"]</span>
            </label>
            <button type="submit" class="btn small danger">@L["Switch off"]</button>
        </form>
    }
</div>

<div class="card" style="max-width:760px" id="privacy">
    <h2 style="margin-top:0">@L["IP address logging (reports)"]</h2>
    <p style="font-size:.88rem;color:var(--tun-slate)">@L["Always on: daily counters with country, region, city and network operator derived from the IP address; the address itself is not stored. Optional: every download and catalog request with IP address, host name and user agent for the reports."]</p>
    @if (Model.IpConfirmedAt is { } confirmedAt)
    {
        <p style="font-size:.88rem">@L["GDPR confirmation given by {0} on {1}.", Model.IpConfirmedBy, Time.Fmt(confirmedAt)]</p>
    }
    @if (!Model.IpOn)
    {
        <form method="post" asp-page-handler="IpEnable">
            @if (Model.IpConfirmedAt is null)
            {
                <div class="alert warn">
                    <p style="margin-top:0"><b>@L["Data protection (GDPR)"]</b></p>
                    <p>@L["IP addresses are personal data under the GDPR, also without a sign-in. Storing them needs a legal basis (for example legitimate interest), a note in the privacy policy and a retention period. Please clarify this with your data protection officer before switching it on."]</p>
                    <label style="display:flex;gap:8px;align-items:flex-start">
                        <input type="checkbox" name="confirmGdpr" value="true" required style="width:auto;margin-top:3px" />
                        <span>@L["I confirm that a legal basis exists, the privacy policy covers this logging and the retention period below is agreed."]</span>
                    </label>
                </div>
            }
            <div>
                <label>@L["Retention period (days)"]</label>
                <input type="number" name="retentionDays" min="1" max="730" value="@(Model.RetentionDays == 0 ? 90 : Model.RetentionDays)" style="width:120px" />
                <label style="display:flex;gap:8px;align-items:flex-start;margin-top:8px;font-size:.88rem">
                        <input type="checkbox" name="permanent" value="true" checked="@(Model.RetentionDays == 0)" style="width:auto;margin-top:3px" />
                        <span><b>@L["Store permanently (no automatic deletion)"]</b><br />
                            <span style="color:var(--tun-slate)">@L["The GDPR requires that personal data is kept no longer than necessary. Choose this only if your data protection officer agreed."]</span></span>
                    </label>
            </div>
            <button type="submit" class="btn cta" style="margin-top:12px">@(Model.IpConfirmedAt is null ? L["Confirm and switch on"] : L["Switch on"])</button>
        </form>
    }
    else
    {
        <p><span class="badge live">@L["On"]</span>
           @(Model.RetentionDays == 0
               ? L["Stored requests: {0}. Kept permanently (no automatic deletion).", Model.IpEventCount]
               : L["Stored requests: {0}. Older than {1} days are deleted automatically.", Model.IpEventCount, Model.RetentionDays])</p>
        <form method="post" asp-page-handler="IpRetention" style="margin-bottom:10px">
            <label>@L["Retention period (days)"]</label>
            <div style="display:flex;gap:6px;align-items:center">
                <input type="number" name="retentionDays" min="1" max="730" value="@(Model.RetentionDays == 0 ? 90 : Model.RetentionDays)" style="width:100px" />
                <button type="submit" class="btn small secondary">@L["Save retention period"]</button>
            </div>
            <label style="display:flex;gap:8px;align-items:flex-start;margin-top:8px;font-size:.88rem">
                        <input type="checkbox" name="permanent" value="true" checked="@(Model.RetentionDays == 0)" style="width:auto;margin-top:3px" />
                        <span><b>@L["Store permanently (no automatic deletion)"]</b><br />
                            <span style="color:var(--tun-slate)">@L["The GDPR requires that personal data is kept no longer than necessary. Choose this only if your data protection officer agreed."]</span></span>
                    </label>
        </form>
        <div style="display:flex;gap:8px;flex-wrap:wrap;align-items:center">
            <form method="post" asp-page-handler="IpDisable">
                <button type="submit" class="btn small secondary">@L["Switch off"]</button>
            </form>
            <a class="btn small secondary" href="/Admin/Reports#ip">@L["Reports"]</a>
        </div>
    }
    @if (Model.IpEventCount > 0)
    {
        <form method="post" asp-page-handler="IpDeleteAll" style="display:flex;gap:6px;align-items:center;margin-top:12px">
            <input name="confirm" placeholder="DELETE" style="width:120px" />
            <button type="submit" class="btn small danger">@L["Delete all stored IP addresses"]</button>
        </form>
    }
</div>
<div class="card" style="max-width:760px" id="feedback-retention">
    <h2 style="margin-top:0">@L["Problem reports"]</h2>
    <p style="font-size:.88rem;color:var(--tun-slate)">@L["Reporters may attach screenshots, PDFs and logs and leave an email address. These are deleted automatically once a report has been closed for the period below; the report text and the notes stay."]</p>
    <form method="post" asp-page-handler="FeedbackRetention">
        <label>@L["Retention period (days)"]</label>
        <div style="display:flex;gap:6px;align-items:center">
            <input type="number" name="feedbackDays" min="7" max="3650" value="@Model.FeedbackRetentionDays" style="width:100px" />
            <button type="submit" class="btn small secondary">@L["Save retention period"]</button>
        </div>
    </form>
</div>
}

</div>
</div>
