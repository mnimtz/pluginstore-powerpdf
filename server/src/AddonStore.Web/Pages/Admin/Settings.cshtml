@page
@model AddonStore.Web.Pages.Admin.SettingsModel
@{
    ViewData["Title"] = "Settings";
}

<h1>@L["Settings"]</h1>
@if (Model.SigningProblem is not null)
{
    <div class="alert error">@L["The package signing key cannot be read. Clients refuse installs until the backup is restored with its key ring password or the App Setting Signing__PrivateKeyPem holds the recovery key."]</div>
}
else if (Model.SigningKeyId.Length > 0)
{
    <p style="font-size:.82rem;color:var(--tun-slate)">@L["Package signing key"]: <code>@Model.SigningKeyId</code></p>
}
<p class="lead">@L["Instance settings; values are stored on the server and take effect immediately."]</p>

<div class="report-layout">
<nav class="report-nav" aria-label="@L["Sections"]">
    @foreach (var (key, label) in AddonStore.Web.Pages.Admin.SettingsModel.Views)
    {
        <a href="@Url.Page("/Admin/Settings", new { view = key == "server" ? null : key })" class="@(Model.View == key ? "active" : "")" aria-current="@(Model.View == key ? "page" : null)">@L[label]</a>
    }
    <a href="/Admin/Backup">@L["Backup and restore"] →</a>
    <a href="/Admin/Categories">@L["Categories"] →</a>
</nav>
<div class="report-main">

@if (Model.Notice is not null)
{
    <div class="alert @Model.NoticeKind">@L[Model.Notice]
        @if (Model.TestDetail is not null)
        {
            <br /><code>@Model.TestDetail</code>
        }
    </div>
}

@if (Model.View == "email")
{
<div class="card" style="max-width:560px">
    <h2 style="margin-top:0">@L["Email notifications (Resend)"]</h2>
    <form method="post" asp-page-handler="Email" class="stack" style="max-width:none">
        <div>
            <label>@L["Resend API key"]</label>
            <input type="password" name="resendKey" placeholder="@(Model.HasResendKey ? "••••••••  (" + L["configured"] + ")" : "re_...")" autocomplete="off" />
        </div>
        <div>
            <label>@L["Sender address"]</label>
            <input type="text" name="from" value="@Model.From" placeholder="Add-on Store &lt;store@yourdomain.com&gt;" />
        </div>
        <button type="submit" class="btn cta">@L["Save"]</button>
    </form>
    <form method="post" asp-page-handler="TestMail" style="margin-top:12px;display:flex;gap:8px;flex-wrap:wrap;align-items:center">
        <label for="testTo" style="margin:0">@L["Recipient"]</label>
        <input type="email" id="testTo" name="testTo" value="@(Model.TestTo ?? Model.MyEmail)" required maxlength="200" style="flex:1;min-width:220px;max-width:340px" />
        <button type="submit" class="btn small secondary">@L["Send test email"]</button>
    </form>
    <p style="font-size:.82rem;color:var(--tun-slate)">@L["Without a verified sender domain, Resend only delivers to the email address of the Resend account owner."]</p>
</div>
}

@if (Model.View == "notifications")
{
<div class="card" style="max-width:760px">
    <h2 style="margin-top:0">@L["Notifications"]</h2>
    <p style="font-size:.88rem;color:var(--tun-slate)">@L["Which emails are sent when, and to whom. Every sent or failed email is recorded in the audit log."]</p>
    <form method="post" asp-page-handler="Notifications">
        <table>
            <tr><th>@L["Active"]</th><th>@L["Event"]</th><th>@L["Recipients"]</th></tr>
            @foreach (var (key, label, recipients) in AddonStore.Web.Services.NotificationService.Events)
            {
                <tr>
                    <td><input type="checkbox" name="enabled" value="@key" checked="@Model.EventEnabled[key]" style="width:auto" /></td>
                    <td>@L[label]</td>
                    <td>@L[recipients]</td>
                </tr>
            }
            <tr>
                <td><input type="checkbox" checked disabled style="width:auto" /></td>
                <td>@L["Invitation"]</td>
                <td>@L["Invited person (always sent)"]</td>
            </tr>
        </table>
        <button type="submit" class="btn cta" style="margin-top:12px">@L["Save"]</button>
    </form>
</div>
}

@if (Model.View == "server")
{
<div class="card" style="max-width:560px">
    <h2 style="margin-top:0">@L["Server"]</h2>
    <form method="post" asp-page-handler="Server" class="stack" style="max-width:none">
        <div>
            <label>@L["Public base URL (used in emails and invite links)"]</label>
            <input type="text" name="baseUrl" value="@Model.BaseUrl" placeholder="https://addon.power-pdf.de" />
        </div>
        <div>
            <label>@L["Time zone for displayed times"]</label>
            <select name="timeZone">
                @foreach (var z in AddonStore.Web.Services.TimeDisplay.Zones)
                {
                    <option value="@z" selected="@(z == Model.TimeZone)">@z</option>
                }
            </select>
        </div>
        <div>
            <label>@L["Source code per version"]</label>
            <select name="sourcePolicy">
                <option value="required" selected="@(Model.SourcePolicy == "required")">@L["Required: no approval without source code"]</option>
                <option value="recommended" selected="@(Model.SourcePolicy == "recommended")">@L["Recommended: approval possible without source code"]</option>
                <option value="off" selected="@(Model.SourcePolicy == "off")">@L["Off"]</option>
            </select>
            <small style="color:var(--tun-slate)">@L["Source code is stored next to each version and visible to admins only; Power PDF clients never receive it."]</small>
        </div>
        <div>
            <label style="display:flex;gap:8px;align-items:center">
                <input type="checkbox" name="fourEyes" value="true" checked="@Model.FourEyes" style="width:auto" />
                @L["Four-eyes rule: nobody approves a version they uploaded or own"]
            </label>
            @if (Model.ApproverCount < 2)
            {
                <small style="color:var(--tun-slate)">@L["Needs at least two active admins or reviewers; with only one, own versions can no longer be approved."]</small>
            }
        </div>
        <button type="submit" class="btn cta">@L["Save"]</button>
    </form>
</div>
}

@if (Model.View == "ai")
{
<div class="card" style="max-width:760px" id="ai">
    <h2 style="margin-top:0">@L["AI assistant (optional)"]</h2>
    <p style="font-size:.88rem;color:var(--tun-slate)">@L["Sorts problem reports, prepares a review aid for new versions and lets users search for add-ons by describing what they need. Off by default; everything works without it."]</p>
    <h3>1. @L["Provider and key"]</h3>
    <form method="post" asp-page-handler="AiConnect" class="stack" style="max-width:none">
        <div>
            <label>@L["Provider"]</label>
            <select name="provider">
                <option value="off" selected="@(Model.Ai.Provider == "off")">@L["Off"]</option>
                <option value="claude" selected="@(Model.Ai.Provider == "claude")">Claude (Anthropic)</option>
                <option value="gemini" selected="@(Model.Ai.Provider == "gemini")">Gemini (Google)</option>
                @if (Model.OfferFake)
                {
                    <option value="fake" selected="@(Model.Ai.Provider == "fake")">Test (Development)</option>
                }
            </select>
        </div>
        <div>
            <label>@L["API key"]</label>
            <input type="password" name="apiKey" placeholder="@(Model.Ai.HasKey ? "••••••••  (" + L["configured"] + ")" : "")" autocomplete="off" />
            @if (Model.Ai.HasKey)
            {
                <label style="font-weight:400"><input type="checkbox" name="clearKey" value="true" style="width:auto" /> @L["Remove stored key"]</label>
            }
            <small style="color:var(--tun-slate)">@L["Stored encrypted on the server and never shown again. Use a key of your own organization with a spending limit."]</small>
        </div>
        <button type="submit" class="btn cta">@L["Connect and load models"]</button>
    </form>

    @if (Model.Ai.On)
    {
        <h3>2. @L["Model and features"]</h3>
        <form method="post" asp-page-handler="Ai" class="stack" style="max-width:none">
            <div>
                <label>@L["Model"]</label>
                @if (Model.AiModels.Count == 0)
                {
                    <p class="muted small">@L["No model list loaded yet: use \"Connect and load models\" above. Until then the default model is used."]</p>
                    <input type="hidden" name="model" value="" />
                }
                else
                {
                    <select name="model">
                        <option value="" selected="@(!Model.AiModels.Any(m => m.Id == Model.Ai.Model))">@L["Default"] (@(Model.Ai.Provider == "gemini" ? AddonStore.Web.Services.AiService.DefaultGeminiModel : AddonStore.Web.Services.AiService.DefaultClaudeModel))</option>
                        @foreach (var m in Model.AiModels)
                        {
                            <option value="@m.Id" selected="@(m.Id == Model.Ai.Model)">@m.Name (@m.Id)</option>
                        }
                    </select>
                    <small style="color:var(--tun-slate)">@L["Models this key may use, loaded live from the provider."]</small>
                }
            </div>
            <div>
                <label style="font-weight:400"><input type="checkbox" name="triage" value="true" checked="@Model.Ai.Triage" style="width:auto" /> @L["Sort problem reports (category, urgency, summary, reply draft, duplicates)"]</label>
                <label style="font-weight:400"><input type="checkbox" name="review" value="true" checked="@Model.Ai.Review" style="width:auto" /> @L["Review aid for new versions (on request)"]</label>
                <label style="font-weight:400;margin-left:24px"><input type="checkbox" name="reviewAuto" value="true" checked="@Model.Ai.ReviewAuto" style="width:auto" /> @L["Create automatically for every new version"]</label>
                <label style="font-weight:400;margin-left:24px"><input type="checkbox" name="reviewSource" value="true" checked="@Model.Ai.ReviewSource" style="width:auto" /> @L["Send changed source code lines to the provider"]</label>
                <label style="font-weight:400;margin-left:24px">@L["Language of automatic review aids"]
                    <select name="reviewLanguage" style="width:auto;margin-left:8px">
                        @foreach (var code in AddonStore.Web.Services.AiAssist.ReviewLanguages.Keys)
                        {
                            var ci = new System.Globalization.CultureInfo(code);
                            <option value="@code" selected="@(Model.Ai.ReviewLanguage == code)">@(char.ToUpper(ci.NativeName[0]) + ci.NativeName[1..])</option>
                        }
                    </select>
                </label>
                <label style="font-weight:400"><input type="checkbox" name="search" value="true" checked="@Model.Ai.Search" style="width:auto" /> @L["Search by need on the website and in the store window"]</label>
            </div>
            <div>
                <label>@L["Requests per day (limit)"]</label>
                <input type="number" name="dailyLimit" value="@Model.Ai.DailyLimit" min="1" max="100000" style="max-width:140px" />
            </div>
            <button type="submit" class="btn cta">@L["Save"]</button>
        </form>
        <h3>3. @L["Test"]</h3>
        <form method="post" asp-page-handler="AiTest">
            <button type="submit" class="btn small secondary">@L["Test connection"]</button>
            <small style="color:var(--tun-slate)">@L["Sends one short request with the chosen model."]</small>
        </form>
    }
    <p style="font-size:.82rem;color:var(--tun-slate)">@L["Data sent to the provider: add-on texts from the catalog, the text of problem reports, search queries, manifests and file lists of new versions, and only with the option above changed source code lines. Never sent: email addresses, IP addresses, log excerpts, user accounts. Check with your data protection team before switching it on."]</p>
</div>
}

@if (Model.View == "privacy")
{
<div class="card" style="max-width:760px" id="privacy">
    <h2 style="margin-top:0">@L["IP address logging (reports)"]</h2>
    <p style="font-size:.88rem;color:var(--tun-slate)">@L["Always on: daily counters with country, region, city and network operator derived from the IP address; the address itself is not stored. Optional: every download and catalog request with IP address, host name and user agent for the reports."]</p>
    @if (Model.IpConfirmedAt is { } confirmedAt)
    {
        <p style="font-size:.88rem">@L["GDPR confirmation given by {0} on {1}.", Model.IpConfirmedBy, Time.Fmt(confirmedAt)]</p>
    }
    @if (!Model.IpOn)
    {
        <form method="post" asp-page-handler="IpEnable">
            @if (Model.IpConfirmedAt is null)
            {
                <div class="alert warn">
                    <p style="margin-top:0"><b>@L["Data protection (GDPR)"]</b></p>
                    <p>@L["IP addresses are personal data under the GDPR, also without a sign-in. Storing them needs a legal basis (for example legitimate interest), a note in the privacy policy and a retention period. Please clarify this with your data protection officer before switching it on."]</p>
                    <label style="display:flex;gap:8px;align-items:flex-start">
                        <input type="checkbox" name="confirmGdpr" value="true" required style="width:auto;margin-top:3px" />
                        <span>@L["I confirm that a legal basis exists, the privacy policy covers this logging and the retention period below is agreed."]</span>
                    </label>
                </div>
            }
            <div>
                <label>@L["Retention period (days)"]</label>
                <input type="number" name="retentionDays" min="1" max="730" value="@(Model.RetentionDays == 0 ? 90 : Model.RetentionDays)" style="width:120px" />
                <label style="display:flex;gap:8px;align-items:flex-start;margin-top:8px;font-size:.88rem">
                        <input type="checkbox" name="permanent" value="true" checked="@(Model.RetentionDays == 0)" style="width:auto;margin-top:3px" />
                        <span><b>@L["Store permanently (no automatic deletion)"]</b><br />
                            <span style="color:var(--tun-slate)">@L["The GDPR requires that personal data is kept no longer than necessary. Choose this only if your data protection officer agreed."]</span></span>
                    </label>
            </div>
            <button type="submit" class="btn cta" style="margin-top:12px">@(Model.IpConfirmedAt is null ? L["Confirm and switch on"] : L["Switch on"])</button>
        </form>
    }
    else
    {
        <p><span class="badge live">@L["On"]</span>
           @(Model.RetentionDays == 0
               ? L["Stored requests: {0}. Kept permanently (no automatic deletion).", Model.IpEventCount]
               : L["Stored requests: {0}. Older than {1} days are deleted automatically.", Model.IpEventCount, Model.RetentionDays])</p>
        <form method="post" asp-page-handler="IpRetention" style="margin-bottom:10px">
            <label>@L["Retention period (days)"]</label>
            <div style="display:flex;gap:6px;align-items:center">
                <input type="number" name="retentionDays" min="1" max="730" value="@(Model.RetentionDays == 0 ? 90 : Model.RetentionDays)" style="width:100px" />
                <button type="submit" class="btn small secondary">@L["Save retention period"]</button>
            </div>
            <label style="display:flex;gap:8px;align-items:flex-start;margin-top:8px;font-size:.88rem">
                        <input type="checkbox" name="permanent" value="true" checked="@(Model.RetentionDays == 0)" style="width:auto;margin-top:3px" />
                        <span><b>@L["Store permanently (no automatic deletion)"]</b><br />
                            <span style="color:var(--tun-slate)">@L["The GDPR requires that personal data is kept no longer than necessary. Choose this only if your data protection officer agreed."]</span></span>
                    </label>
        </form>
        <div style="display:flex;gap:8px;flex-wrap:wrap;align-items:center">
            <form method="post" asp-page-handler="IpDisable">
                <button type="submit" class="btn small secondary">@L["Switch off"]</button>
            </form>
            <a class="btn small secondary" href="/Admin/Reports#ip">@L["Reports"]</a>
        </div>
    }
    @if (Model.IpEventCount > 0)
    {
        <form method="post" asp-page-handler="IpDeleteAll" style="display:flex;gap:6px;align-items:center;margin-top:12px">
            <input name="confirm" placeholder="DELETE" style="width:120px" />
            <button type="submit" class="btn small danger">@L["Delete all stored IP addresses"]</button>
        </form>
    }
</div>
}

</div>
</div>
