@page
@model AddonStore.Web.Pages.ProfileModel
@{
    ViewData["Title"] = "Profile";
}

<h1>@L["Profile"]</h1>

@if (Model.Notice is not null)
{
    <div class="alert @Model.NoticeKind">@L[Model.Notice]</div>
}

<div class="card" style="max-width:560px">
    <h2 style="margin-top:0">@L["My profile"]</h2>
    <form method="post" asp-page-handler="Profile" enctype="multipart/form-data" class="stack" style="max-width:none">
        <div style="display:flex;gap:16px;align-items:center">
            @if (Model.Me?.AvatarFile is not null)
            {
                <img src="/avatar/@Model.Me.Id" alt="" style="width:56px;height:56px;border-radius:50%;object-fit:cover;border:2px solid var(--tun-gray-200)" />
            }
            <div style="flex:1">
                <label>@L["Display name"]</label>
                <input type="text" name="name" value="@Model.Me?.DisplayName" required maxlength="100" />
            </div>
        </div>
        <div>
            <label>@L["Profile picture (PNG or JPEG, max. 512 KB)"]</label>
            <input type="file" name="avatar" accept=".png,.jpg,.jpeg" />
        </div>
        <div>
            <label style="display:flex;gap:8px;align-items:flex-start;font-weight:400">
                <input type="checkbox" name="showContact" value="true" checked="@(Model.Me?.ShowContactPublicly ?? true)" style="width:auto;margin-top:3px" />
                <span>@L["Show my name and email as author of my plugins in the public catalog"]<br />
                    <small style="color:var(--tun-slate)">@L["When off, the catalog shows “Tungsten Automation” instead."]</small></span>
            </label>
        </div>
        <button type="submit" class="btn">@L["Save"]</button>
    </form>
</div>

<h2>@L["API tokens"]</h2>
<p class="lead">@L["Personal API tokens let tools and AI assistants upload and update your plugins on your behalf."]</p>

@if (Model.NewToken is not null)
{
    <div class="alert ok">
        @L["Token created. Copy it now; it is shown only this once:"]
        <div class="token-reveal">@Model.NewToken</div>
    </div>
}

<div class="card">
    <h2 style="margin-top:0">@L["Create a token"]</h2>
    <form method="post" asp-page-handler="Create" class="stack">
        <div>
            <label for="name">@L["Token name (e.g. 'claude', 'build server')"]</label>
            <input type="text" id="name" name="name" maxlength="60" required />
        </div>
        <button type="submit" class="btn cta">@L["Create token"]</button>
    </form>
    <p style="font-size:.85rem;color:var(--tun-slate)">
        @L["Give the token to your Claude together with this line:"]<br />
        <code>@L["Plugin store:"] @($"{Request.Scheme}://{Request.Host}/api/agent-guide")</code>
    </p>
</div>

<h2>@L["My tokens"]</h2>
<table>
    <tr><th>@L["Name"]</th><th>@L["Prefix"]</th><th>@L["Created"]</th><th>@L["Last used"]</th><th>@L["Status"]</th><th></th></tr>
    @foreach (var t in Model.Tokens)
    {
        <tr>
            <td>@t.Name</td>
            <td><code>@t.Prefix…</code></td>
            <td>@Time.Fmt(t.CreatedAt, false)</td>
            <td>@Time.Fmt(t.LastUsedAt)</td>
            <td>
                @if (t.RevokedAt is null)
                {
                    <span class="badge active">@L["active"]</span>
                }
                else
                {
                    <span class="badge disabled">@L["revoked"]</span>
                }
            </td>
            <td>
                @if (t.RevokedAt is null)
                {
                    <form method="post" asp-page-handler="Revoke" style="display:inline">
                        <input type="hidden" name="id" value="@t.Id" />
                        <button type="submit" class="btn small danger">@L["Revoke"]</button>
                    </form>
                }
            </td>
        </tr>
    }
</table>
