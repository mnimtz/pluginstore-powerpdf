@page
@model AddonStore.Web.Pages.ProfileModel
@{
    ViewData["Title"] = "Profile";
}

<h1>@L["Profile"]</h1>

@if (Model.Notice is not null)
{
    <div class="alert @Model.NoticeKind">@L[Model.Notice]</div>
}

<div class="card" style="max-width:560px">
    <h2 style="margin-top:0">@L["My profile"]</h2>
    <form method="post" asp-page-handler="Profile" enctype="multipart/form-data" class="stack" style="max-width:none">
        <div style="display:flex;gap:16px;align-items:center">
            @if (Model.Me?.AvatarFile is not null)
            {
                <img src="/avatar/@Model.Me.Id" alt="" style="width:56px;height:56px;border-radius:50%;object-fit:cover;border:2px solid var(--tun-gray-200)" />
            }
            <div style="flex:1">
                <label>@L["Display name"]</label>
                <input type="text" name="name" value="@Model.Me?.DisplayName" required maxlength="100" />
            </div>
        </div>
        <div>
            <label>@L["Profile picture (PNG or JPEG, max. 512 KB)"]</label>
            <input type="file" name="avatar" accept=".png,.jpg,.jpeg" />
        </div>
        <div>
            <label style="display:flex;gap:8px;align-items:flex-start;font-weight:400">
                <input type="checkbox" name="showContact" value="true" checked="@(Model.Me?.ShowContactPublicly ?? true)" style="width:auto;margin-top:3px" />
                <span>@L["Show my name and email as author of my plugins in the public catalog"]<br />
                    <small style="color:var(--tun-slate)">@L["When off, the catalog shows “Tungsten Automation” instead."]</small></span>
            </label>
        </div>
        <div>
            <label style="display:flex;gap:8px;align-items:flex-start;font-weight:400">
                <input type="checkbox" name="notifyPlugins" value="true" checked="@(Model.Me?.NotifyAboutPlugins ?? true)" style="width:auto;margin-top:3px" />
                <span>@L["Email me about my plug-ins"]<br />
                    <small style="color:var(--tun-slate)">@L["Upload confirmation, approval or rejection, withdrawn or restored versions and catalog changes made by an admin."]</small></span>
            </label>
        </div>
        <button type="submit" class="btn">@L["Save"]</button>
    </form>
</div>

<div class="card" style="max-width:560px">
    <h2 style="margin-top:0">@L["Change password"]</h2>
    <form method="post" asp-page-handler="Password" class="stack" style="max-width:none">
        <div>
            <label for="current">@L["Current password"]</label>
            <input type="password" id="current" name="current" required maxlength="200" autocomplete="current-password" />
        </div>
        <div>
            <label for="pw1">@L["New password"]</label>
            <input type="password" id="pw1" name="password" required minlength="10" maxlength="200" autocomplete="new-password" />
        </div>
        <div>
            <label for="pw2">@L["Repeat the new password"]</label>
            <input type="password" id="pw2" name="password2" required minlength="10" maxlength="200" autocomplete="new-password" />
        </div>
        <button type="submit" class="btn">@L["Change password"]</button>
    </form>
</div>

<div class="card" style="max-width:720px" id="testcode">
    <h2 style="margin-top:0">@L["Personal test code"]</h2>
    <p class="muted">@L["New versions wait for review and reach no workstation until a reviewer approves them. With this code you try your own add-ons in Power PDF first: enter it in the store window with \"Customer code\". It shows the newest version of each of your add-ons, also one that waits for review. Treat it like a password."]</p>
    @if (Model.TestCode is not null)
    {
        <div class="token-reveal">@Model.TestCode</div>
        <div style="display:flex;gap:8px;flex-wrap:wrap;margin-top:10px">
            <form method="post" asp-page-handler="TestCode" data-confirm="@L["Create a new test code? The current one stops working at once."]">
                <button type="submit" class="btn small secondary">@L["New code"]</button>
            </form>
            <form method="post" asp-page-handler="TestCodeRevoke" data-confirm="@L["Delete the test code? It stops working at once."]">
                <button type="submit" class="btn small danger">@L["Delete"]</button>
            </form>
        </div>
    }
    else
    {
        <form method="post" asp-page-handler="TestCode">
            <button type="submit" class="btn small">@L["Create test code"]</button>
        </form>
    }
</div>

<h2>@L["API tokens"]</h2>
<p class="lead">@L["Personal API tokens let tools and AI assistants upload and update your plugins on your behalf."]</p>

@if (Model.NewToken is not null)
{
    <div class="alert ok">
        @L["Token created. Copy it now; it is shown only this once:"]
        <div class="token-reveal">@Model.NewToken</div>
    </div>
}

<div class="card">
    <h2 style="margin-top:0">@L["Create a token"]</h2>
    <form method="post" asp-page-handler="Create" class="stack">
        <div>
            <label for="name">@L["Token name (e.g. 'assistant', 'build server')"]</label>
            <input type="text" id="name" name="name" maxlength="60" required />
        </div>
        <button type="submit" class="btn cta">@L["Create token"]</button>
    </form>
    <p style="font-size:.85rem;color:var(--tun-slate)">
        @L["Give the token to your AI assistant together with this line:"]<br />
        <code>@L["Plugin store:"] @($"{Request.Scheme}://{Request.Host}/agent-guide")</code>
    </p>
</div>

<h2>@L["My tokens"]</h2>
<div class="table-wrap"><table>
    <tr><th>@L["Name"]</th><th>@L["Prefix"]</th><th>@L["Created"]</th><th>@L["Last used"]</th><th>@L["Status"]</th><th></th></tr>
    @foreach (var t in Model.Tokens)
    {
        <tr>
            <td>@t.Name</td>
            <td><code>@t.Prefix…</code></td>
            <td>@Time.Fmt(t.CreatedAt, false)</td>
            <td>@Time.Fmt(t.LastUsedAt)</td>
            <td>
                @if (t.RevokedAt is null)
                {
                    <span class="badge active">@L["Active"]</span>
                }
                else
                {
                    <span class="badge disabled">@L["revoked"]</span>
                }
            </td>
            <td>
                @if (t.RevokedAt is null)
                {
                    <form method="post" asp-page-handler="Revoke" style="display:inline">
                        <input type="hidden" name="id" value="@t.Id" />
                        <button type="submit" class="btn small danger">@L["Revoke"]</button>
                    </form>
                }
            </td>
        </tr>
    }
</table></div>
