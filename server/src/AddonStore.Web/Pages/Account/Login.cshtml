@page
@model AddonStore.Web.Pages.Account.LoginModel
@inject AddonStore.Web.Auth.EntraSettings Entra
@{
    ViewData["Title"] = "Sign in";
}

<h1>@L["Sign in"]</h1>
<p class="lead">@L["For plugin developers and admins. End users install plugins directly from the Add-on Store ribbon in Power PDF, no account needed."]</p>

@if (Model.Message is not null)
{
    <div class="alert @Model.MessageKind">@L[Model.Message]</div>
}

<div class="card" style="max-width:480px">
    <form method="post" class="stack">
        <div>
            <label for="email">@L["Email"]</label>
            <input type="email" id="email" name="email" required />
        </div>
        <div>
            <label for="password">@L["Password"]</label>
            <input type="password" id="password" name="password" required />
        </div>
        <button type="submit" class="btn">@L["Sign in"]</button>
    </form>
    @if (Entra.Enabled)
    {
        @* "Sign in with Microsoft" (Entra ID, docs/entra-setup.md): a plain link, see Auth/EntraSignIn.cs *@
        <p class="muted" style="text-align:center;margin:14px 0 10px">@L["or"]</p>
        <a class="btn secondary" href="@AddonStore.Web.Auth.EntraSettings.ChallengePath" style="display:flex;gap:10px;align-items:center;justify-content:center">
            <svg width="18" height="18" viewBox="0 0 21 21" aria-hidden="true" focusable="false"><rect x="1" y="1" width="9" height="9" fill="#f25022"/><rect x="11" y="1" width="9" height="9" fill="#7fba00"/><rect x="1" y="11" width="9" height="9" fill="#00a4ef"/><rect x="11" y="11" width="9" height="9" fill="#ffb900"/></svg>
            <span>@L["Sign in with Microsoft"]</span>
        </a>
    }
    <p style="margin-bottom:0;font-size:.9rem">
        <a href="/Account/Forgot">@L["Forgot password?"]</a> &middot;
        @L["No account yet?"] <a href="/Account/Register">@L["Request access"]</a>
    </p>
</div>
