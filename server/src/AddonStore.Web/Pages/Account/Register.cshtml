@page
@model AddonStore.Web.Pages.Account.RegisterModel
@{
    ViewData["Title"] = "Request access";
}

<h1>@L["Request access"]</h1>
<p class="lead">@L["Accounts are for colleagues who develop and publish plugins. An admin reviews every request; you will be notified by email."]</p>

@if (Model.Error is not null)
{
    <div class="alert error">@L[Model.Error]</div>
}

<div class="card" style="max-width:480px">
    <form method="post" class="stack">
        @* Bot traps (S0.18.2): a field people never see, and the time the form was shown. *@
        <div class="hp-field" aria-hidden="true">
            <label for="website">Website</label>
            <input type="text" id="website" name="website" tabindex="-1" autocomplete="off" />
        </div>
        <input type="hidden" name="shown" value="@Model.Shown" />
        <div>
            <label for="name">@L["Display name"]</label>
            <input type="text" id="name" name="name" required maxlength="100" />
        </div>
        <div>
            <label for="email">@L["Email"]</label>
            <input type="email" id="email" name="email" required maxlength="200" />
        </div>
        <div>
            <label for="password">@L["Password"]</label>
            <input type="password" id="password" name="password" required minlength="10" />
        </div>
        <div>
            <label for="reason">@L["What do you plan to publish? (shown to the admin)"]</label>
            <textarea id="reason" name="reason" rows="3" maxlength="500"></textarea>
        </div>
        <button type="submit" class="btn cta">@L["Submit request"]</button>
    </form>
</div>
