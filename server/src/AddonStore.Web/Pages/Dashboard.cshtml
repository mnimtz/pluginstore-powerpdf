@page
@using System.Text.Json
@model AddonStore.Web.Pages.DashboardModel
@{
    var isAdmin = User.IsInRole("Admin");
    var heading = isAdmin ? "All plug-ins" : "My plug-ins";
    ViewData["Title"] = heading;
}

<h1>@L[heading]</h1>
<p class="lead">@L[isAdmin ? "Every plug-in in the store. Open Details to approve, withdraw or restore versions and to edit the catalog entry." : "Your plug-ins. Open Details for versions, check reports and the catalog entry."]</p>

@if (Model.Notice is not null)
{
    <div class="alert @Model.NoticeKind">@L[Model.Notice]</div>
}
@if (Model.Findings.Count > 0)
{
    <ul class="findings">
        @foreach (var f in Model.Findings)
        {
            <li class="@f.Severity">
                <span class="code">@f.Code</span> @f.Message
                <span class="hint">@f.Hint</span>
            </li>
        }
    </ul>
}
@if (Model.SourceNotice is not null)
{
    <div class="alert @Model.SourceNoticeKind">@L[Model.SourceNotice]</div>
}
@if (Model.SourceFindings.Count > 0)
{
    <ul class="findings">
        @foreach (var f in Model.SourceFindings)
        {
            <li class="@f.Severity"><span class="code">@f.Code</span> @f.Message <span class="hint">@f.Hint</span></li>
        }
    </ul>
}

<details class="card" @(Model.Findings.Count > 0 ? "open" : "")>
    <summary style="cursor:pointer;font-weight:600;color:var(--tun-navy)">@L["Submit a package"]</summary>
    <p style="color:var(--tun-slate);font-size:.9rem">@L["Upload a .ppak package below, or automate it via the API with a personal token from your profile."]
        @L["An upload package (.zip with the .ppak and the source ZIP, made by make-ppak.ps1 or your AI assistant) submits the version and stores its source code in one step."]</p>
    <form method="post" enctype="multipart/form-data" class="stack">
        <div>
            <label for="package">@L["Package file (.ppak or upload package .zip)"]</label>
            <input type="file" id="package" name="package" accept=".ppak,.zip" required />
        </div>
        <button type="submit" class="btn cta">@L["Upload and validate"]</button>
    </form>
</details>

@{
    int all = Model.Rows.Count, pending = Model.Rows.Count(r => r.Pending),
        live = Model.Rows.Count(r => r.Live is not null), offline = Model.Rows.Count(r => !r.InStore),
        beta = Model.Rows.Count(r => r.Beta is not null), privCount = Model.Rows.Count(r => r.Pkg.Visibility == "private");
    string Chip(string f) => Model.Filter == f || (f == "all" && Model.Filter is not ("pending" or "live" or "beta" or "private" or "offline")) ? "chip active" : "chip";
}
<form method="get" style="display:flex;gap:12px;flex-wrap:wrap;align-items:center;margin:18px 0 12px">
    <div class="chips">
        <a class="@Chip("all")" href="?filter=all&q=@Model.Q">@L["All"] (@all)</a>
        <a class="@Chip("pending")" href="?filter=pending&q=@Model.Q">@L["Awaiting approval"] (@pending)</a>
        <a class="@Chip("live")" href="?filter=live&q=@Model.Q">@L["Live"] (@live)</a>
        <a class="@Chip("beta")" href="?filter=beta&q=@Model.Q">@L["Beta"] (@beta)</a>
        <a class="@Chip("private")" href="?filter=private&q=@Model.Q">@L["Private (customers only)"] (@privCount)</a>
        <a class="@Chip("offline")" href="?filter=offline&q=@Model.Q">@L["Not in the store"] (@offline)</a>
    </div>
    <input type="hidden" name="filter" value="@Model.Filter" />
    <input type="search" name="q" value="@Model.Q" placeholder="@L["Search name, id or owner"]" style="flex:1;min-width:200px;max-width:320px" />
</form>

@if (Model.Visible.Count == 0)
{
    <div class="card">@L[Model.Rows.Count == 0 ? "You have not submitted any packages yet." : "No plug-ins match this filter."]</div>
}
else
{
    <div class="table-wrap" id="plugins">
    <table>
        <tr>
            <th>@L["Plug-in"]</th>
            @if (isAdmin) { <th>@L["Owner"]</th> }
            <th>@L["Live"]</th><th>@L["Status"]</th><th>@L["Visibility"]</th><th>@L["Downloads"]</th><th>@L["Last activity"]</th><th></th>
        </tr>
        @foreach (var r in AddonStore.Web.Services.Paging.Items(Model.Visible, ViewContext.HttpContext.Request, "plugins"))
        {
            <tr>
                <td><b style="color:var(--tun-navy)">@r.Name</b><br /><span style="color:var(--tun-slate);font-size:.8rem">@r.Pkg.Id</span></td>
                @if (isAdmin) { <td>@r.Owner</td> }
                <td>@(r.Live?.Version ?? "-")</td>
                <td>
                    @if (r.Pending)
                    {
                        <span class="badge beta">@L["Awaiting approval"] @r.Beta!.Version</span>
                    }
                    else if (r.Live is not null)
                    {
                        <span class="badge live">@L["Live"]</span>
                    }
                    else if (r.Newest is not null)
                    {
                        <span class="badge @r.Newest.Status.ToString().ToLowerInvariant()">@L[r.Newest.Status.ToString()]</span>
                    }
                </td>
                <td style="white-space:nowrap">
                    @if (r.Pkg.Id == "com.tungsten.pluginstore")
                    {
                        <span class="badge live">@L["public"]</span>
                    }
                    else
                    {
                        var priv = r.Pkg.Visibility == "private";
                        <form method="post" action="/Plugin?id=@Uri.EscapeDataString(r.Pkg.Id)&amp;handler=Visibility" style="display:inline-flex;gap:6px;align-items:center;margin:0"
                              data-confirm="@(priv ? L["Make this add-on public? It then appears in the catalog for everybody (new versions after approval)."] : L["Make this add-on private? It disappears from the public catalog; only customers with a delivery and a code still get it."])">
                            <span class="badge @(priv ? "submitted" : "live")">@L[priv ? "private" : "public"]</span>
                            <input type="hidden" name="visibility" value="@(priv ? "public" : "private")" />
                            <input type="hidden" name="returnUrl" value="@(ViewContext.HttpContext.Request.Path + ViewContext.HttpContext.Request.QueryString)" />
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn small secondary" title="@L[priv ? "Show in the public catalog" : "Customer deliveries only, not in the public catalog"]">@L[priv ? "Make public" : "Make private"]</button>
                        </form>
                    }
                </td>
                <td>@r.Downloads</td>
                <td>@Time.Fmt(r.LastActivity, false)</td>
                <td style="text-align:right;white-space:nowrap"><a class="btn small" href="/Plugin?id=@r.Pkg.Id">@L["Details"]</a></td>
            </tr>
        }
    </table>
    </div>
    <partial name="_Pager" model='new AddonStore.Web.Services.PagerModel("plugins", Model.Visible.Count)' />
}
