@page "/{slug}"
@model AddonStore.Web.Pages.CustomerCatalogModel
@{
    ViewData["PublicPage"] = true;   // public: the classic layout, like the catalog
    if (Model.View is null) { return; }
    var v = Model.View;
    var c = v.Customer;
    ViewData["Title"] = c.Name;
}

@* S2.8.6: the customer's own catalog page: logo, its name as heading, intro, its public add-ons *@
<div class="hero hero-compact custpage-head@(c.BannerFile is not null ? " has-banner" : "")">
    @if (c.BannerFile is not null)
    {
        @* S2.8.7: the banner image fills the head; a navy veil on the side of the text keeps it readable *@
        <img class="custpage-banner" src="/customer-banner/@c.Id?v=@(c.BannerUpdatedAt?.Ticks ?? 0)" alt="" />
        <span class="custpage-veil" aria-hidden="true"></span>
    }
    @if (c.LogoFile is not null)
    {
        <img class="custpage-logo" src="/customer-logo/@c.Id?v=@(c.LogoUpdatedAt?.Ticks ?? 0)" alt="@c.Name" />
    }
    <h1>@c.Name</h1>
    @if (!string.IsNullOrEmpty(c.PageIntro))
    {
        <p class="hero-lead custpage-intro">@c.PageIntro</p>
    }
    @if (v.Code is not null)
    {
        <p class="custpage-code">@L["In the Add-on Store window in Power PDF, enter the customer code {0} to see exactly these add-ons.", v.Code]</p>
    }
    @if (Model.ClientVersion is not null)
    {
        <p class="desktop-only custpage-cta"><a class="btn cta" href="/download/pluginstore.msi">@L["Download"]: Add-on Store @L["for Power PDF"] v@(Model.ClientVersion)</a></p>
    }
</div>

@if (v.Items.Count == 0)
{
    <p class="card muted">@L["No add-ons on this page yet."]</p>
}
else
{
    <div class="catalog" id="pkg-catalog">
        <div class="grid" id="pkg-grid">
            @foreach (var item in v.Items)
            {
                <div class="card pkg" data-id="@item.Id">
                    <div class="pkg-top">
                        <img class="pkg-icon" src="/api/packages/@item.Id/icon?v=@Uri.EscapeDataString(item.Version)" alt="" width="48" height="48" loading="lazy" data-fallback="/img/tungsten-power-pdf-icon.svg" />
                        <div class="pkg-head">
                            <a class="name" href="/a/@Model.Slugs[item.Id]">@item.Name</a>
                            <span class="pkg-sub">
                                <span class="badge live cat">@item.CategoryName</span>
                                <span class="ver">v@(item.Version)</span>
                                <partial name="_Stars" model="(item.Rating, item.RatingCount)" />
                            </span>
                        </div>
                    </div>
                    <span class="desc" title="@item.Description">@item.Description</span>
                    <span class="meta author">@if (item.Author.Length > 0) { <text>@L["Author"]: @item.Author</text> }</span>
                    <span class="pkg-actions">
                        <a class="btn small win-only install" href="addonstore://install/@item.Id"
                           title="@L["Opens Power PDF with this add-on selected and asks before installing. Requires the Add-on Store for Power PDF (version 0.3.7 or later)."]">@L["Install in Power PDF"]</a>
                        <a class="btn small secondary" href="/a/@Model.Slugs[item.Id]">@L["Details"]</a>
                        <span class="client-hint" hidden>
                            @L["Nothing happened? This button needs the Add-on Store for Power PDF, version 0.3.7 or later, on this computer. Install it once (or update it in the store dialog), then click the button again."]
                            <a href="/download/pluginstore.msi">@L["Download the Add-on Store"]</a>
                        </span>
                    </span>
                </div>
            }
        </div>
    </div>
}
<p class="small muted custpage-all"><a href="/">@L["All add-ons in the Add-on Store"] →</a></p>

<style nonce="@ViewContext.HttpContext.Items["CspNonce"]">
    .custpage-head{text-align:start}
    /* a white plate: a dark logo with a transparent background stays visible on the dark head */
    .custpage-logo{display:block;max-height:88px;max-width:min(320px,80%);width:auto;height:auto;object-fit:contain;margin:0 0 14px;background:#fff;padding:8px 10px;border-radius:8px;box-sizing:content-box}
    /* S2.8.7: banner image across the head, without the flow lines; the text stays in a navy veil at its start */
    .custpage-head.has-banner{background-image:none;min-height:240px;display:flex;flex-direction:column;justify-content:flex-end;overflow:hidden}
    .custpage-head.has-banner > *{position:relative;z-index:2}
    .custpage-head.has-banner > .custpage-banner{position:absolute;inset:0;z-index:0;width:100%;height:100%;max-width:none;object-fit:cover;border-radius:inherit}
    .custpage-head.has-banner > .custpage-veil{position:absolute;inset:0;z-index:1;max-width:none;border-radius:inherit;
        background:linear-gradient(90deg,rgba(0,40,84,.94) 0%,rgba(0,40,84,.86) 38%,rgba(0,40,84,.35) 72%,rgba(0,40,84,.1) 100%)}
    [dir=rtl] .custpage-head.has-banner > .custpage-veil{background:linear-gradient(270deg,rgba(0,40,84,.94) 0%,rgba(0,40,84,.86) 38%,rgba(0,40,84,.35) 72%,rgba(0,40,84,.1) 100%)}
    @@media (max-width:700px){ .custpage-head.has-banner > .custpage-veil{background:rgba(0,40,84,.82)} .custpage-head.has-banner{min-height:200px} }
    .custpage-intro{white-space:pre-line;max-width:760px}
    .custpage-code{font-weight:600;margin-top:6px}
    .custpage-cta{margin-top:10px}
    .custpage-all{margin-top:18px}
</style>
<script nonce="@ViewContext.HttpContext.Items["CspNonce"]">
    // Without a registered addonstore:// handler the browser does nothing: show how to get the client (as on the catalog).
    document.querySelectorAll('.pkg-actions a.install').forEach(function (a) {
        a.addEventListener('click', function () {
            var hint = a.parentNode.querySelector('.client-hint'), left = false;
            function gone() { left = true; }
            window.addEventListener('blur', gone);
            document.addEventListener('visibilitychange', gone);
            setTimeout(function () {
                window.removeEventListener('blur', gone);
                document.removeEventListener('visibilitychange', gone);
                if (!left && hint) hint.hidden = false;
            }, 1800);
        });
    });
</script>
