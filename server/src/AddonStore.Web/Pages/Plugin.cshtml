@page
@using AddonStore.Web.Data
@using AddonStore.Web.Services
@model AddonStore.Web.Pages.PluginModel
@{
    var pkg = Model.Pkg!;
    ViewData["Title"] = Model.Name;
    var lang = AddonStore.Web.Services.Lang.Current;
    var me = Model.Me!;
    var offeredLive = Model.Versions.FirstOrDefault(x => x.Status == VersionStatus.Live)?.Id;
}

<p style="margin:0 0 6px"><a href="/Dashboard">← @L[Model.IsAdmin ? "All plug-ins" : "My plug-ins"]</a></p>
<h1 style="margin-bottom:4px">@Model.Name</h1>
<p class="lead" style="margin-top:0">@pkg.Id · @L["Owner"]: @(pkg.Owner?.DisplayName)</p>

@if (Model.Notice is not null)
{
    <div class="alert @Model.NoticeKind">@L[Model.Notice]</div>
}
@if (pkg.BlockedAt is not null)
{
    <div class="alert error"><b>@L["This add-on is blocked for a security reason."]</b> @pkg.BlockReason
        <small>(@pkg.BlockedBy · @Time.Fmt(pkg.BlockedAt.Value, false))</small></div>
}
@if (Model.SourceFindings.Count > 0)
{
    <ul class="findings">
        @foreach (var f in Model.SourceFindings)
        {
            <li class="@f.Severity"><span class="code">@f.Code</span> @f.Message <span class="hint">@f.Hint</span></li>
        }
    </ul>
}

<div class="card">
    <div style="display:flex;gap:24px;flex-wrap:wrap">
        <div style="flex:2;min-width:280px">
            <p style="margin-top:0">@Model.Description</p>
            <table style="width:auto">
                <tr><th style="text-align:left;padding-right:16px">@L["In the store"]</th>
                    <td>
                        @if (Model.InCatalog is null)
                        {
                            <span class="badge withdrawn">@L["Not in the store"]</span>
                        }
                        else
                        {
                            <span class="badge @(Model.InCatalog.Channel == "live" ? "live" : "beta")">@(Model.InCatalog.Channel == "live" ? L["Live"] : L["Beta"]) @Model.InCatalog.Version</span>
                        }
                    </td></tr>
                <tr><th style="text-align:left;padding-right:16px">@L["Author"]</th><td>@(Model.InCatalog?.Author ?? "-")</td></tr>
                <tr><th style="text-align:left;padding-right:16px">@L["Contact"]</th><td>@(Model.InCatalog?.ContactEmail is { Length: > 0 } c ? c : "-")</td></tr>
                <tr><th style="text-align:left;padding-right:16px">@L["Category"]</th><td>@(Model.InCatalog?.CategoryName ?? "-")</td></tr>
                @if (Model.InCatalog?.NoUi == true)
                {
                    <tr><th style="text-align:left;padding-right:16px">@L["Ribbon"]</th><td><span class="badge submitted">@L["No ribbon buttons"]</span></td></tr>
                }
                <tr><th style="text-align:left;padding-right:16px">@L["Downloads"]</th><td>@Model.Versions.Sum(v => v.Downloads)</td></tr>
            </table>
        </div>
        <div style="flex:1;min-width:220px;display:flex;flex-direction:column;gap:10px;align-items:flex-start">
            @if (Model.IsOwner || Model.IsAdmin)
            {
                <a class="btn small" href="/CatalogEntry?id=@pkg.Id">@L["Edit catalog entry"]</a>
                @if (pkg.Id != "com.tungsten.pluginstore")
                {
                    <form method="post" asp-page-handler="Visibility" asp-route-id="@pkg.Id" style="display:flex;gap:6px;align-items:center;flex-wrap:wrap">
                        <label style="margin:0">@L["Visibility"]</label>
                        <select name="visibility" style="width:auto">
                            <option value="public" selected="@(pkg.Visibility != "private")">@L["public (catalog)"]</option>
                            <option value="private" selected="@(pkg.Visibility == "private")">@L["private (customer deliveries only)"]</option>
                        </select>
                        <button type="submit" class="btn small secondary">@L["Save"]</button>
                    </form>
                }
            }
            @if (Model.IsAdmin && Model.InCatalog is not null)
            {
                <form method="post" asp-page-handler="WithdrawAll" asp-route-id="@pkg.Id"
                      data-confirm="@L["Take this plug-in out of the store? All live and beta versions are withdrawn; installed copies keep working."]">
                    <button type="submit" class="btn small danger">@L["Take out of the store"]</button>
                </form>
            }
            @if (Model.IsAdmin && pkg.Id != "com.tungsten.pluginstore")
            {
                if (pkg.BlockedAt is null)
                {
                    <details class="approve-box">
                        <summary class="btn small danger">@L["Security block"]</summary>
                        <form method="post" asp-page-handler="BlockPackage" asp-route-id="@pkg.Id" class="stack" style="max-width:none;margin-top:8px"
                              data-confirm="@L["Block the whole add-on? Every version is withdrawn, uploads are refused, and every Power PDF that has it installed asks its user to remove it."]">
                            <label for="pkg-block">@L["Reason (users see it)"]</label>
                            <input id="pkg-block" name="reason" required minlength="3" maxlength="300" placeholder="@L["e.g. sends document content to an undeclared server"]" />
                            <button type="submit" class="btn small danger">@L["Block all versions"]</button>
                        </form>
                    </details>
                }
                else
                {
                    <form method="post" asp-page-handler="UnblockPackage" asp-route-id="@pkg.Id"
                          data-confirm="@L["Lift the block? The versions stay withdrawn until you restore them."]">
                        <button type="submit" class="btn small secondary">@L["Lift the block"]</button>
                    </form>
                }
            }
        </div>
    </div>
</div>

<h2 id="versions">@L["Versions"]</h2>
<div class="table-wrap">
<table>
    <tr><th>@L["Version"]</th><th>@L["Status"]</th><th>@L["Changelog"]</th><th>@L["Submitted"]</th><th>@L["Downloads"]</th><th style="text-align:right">@L["Actions"]</th></tr>
    @foreach (var v in AddonStore.Web.Services.Paging.Items(Model.Versions, ViewContext.HttpContext.Request, "versions"))
    {
        <tr>
            <td><b>@v.Version</b></td>
            <td>
                <span class="badge @v.Status.ToString().ToLowerInvariant()">@L[v.Status.ToString()]</span>
                @if (v.BlockedAt is not null)
                {
                    <br /><span class="badge rejected">@L["Blocked"]</span> <small style="color:var(--tun-slate)">@v.BlockReason · @v.BlockedBy · @Time.Fmt(v.BlockedAt.Value, false)</small>
                }
                @if (v.Status == VersionStatus.Live && v.Id != offeredLive)
                {
                    <br /><small style="color:var(--tun-slate)">@L["Older version, no longer offered"]</small>
                }
                @if (!string.IsNullOrEmpty(v.ReviewComment))
                {
                    <br /><small style="color:var(--tun-slate)">@v.ReviewComment</small>
                }
            </td>
            <td style="max-width:420px">@CatalogUi.ManifestText(v, "changelog", lang, v.Changelog)</td>
            <td>@Time.Fmt(v.SubmittedAt, false)<br /><small style="color:var(--tun-slate)">@v.SubmittedBy</small></td>
            <td>@v.Downloads</td>
            <td style="text-align:right">
                <div style="display:flex;gap:6px;justify-content:flex-end;flex-wrap:wrap">
                    @if (v.Status is VersionStatus.Live or VersionStatus.Beta)
                    {
                        <a class="btn small secondary" href="/api/packages/@v.PackageId/@v.Version/download">@L["Download"]</a>
                    }
                    @if (Model.CanReview && v.Status == VersionStatus.Beta)
                    {
                        <partial name="_ApprovalForm" model='(v.Id, "versionId", (string?)pkg.Id, "Approve")' />
                    }
                    @if (VersionActionService.CanDemote(v, Model.IsAdmin))
                    {
                        <form method="post" asp-page-handler="Demote" asp-route-id="@pkg.Id"
                              data-confirm="@L["Set this version back to beta? Only beta workstations are offered it from now on, the live channel falls back to the previous live version, and it needs approval again. Installed copies keep working."]">
                            <input type="hidden" name="versionId" value="@v.Id" />
                            <button type="submit" class="btn small secondary">@L["Back to beta"]</button>
                        </form>
                    }
                    @if (VersionActionService.CanWithdraw(v, me, Model.IsAdmin))
                    {
                        <form method="post" asp-page-handler="Withdraw" asp-route-id="@pkg.Id"
                              data-confirm="@L["Withdraw this version?"]">
                            <input type="hidden" name="versionId" value="@v.Id" />
                            <button type="submit" class="btn small danger">@L["Withdraw"]</button>
                        </form>
                    }
                    @if (Model.IsAdmin && v.PackageId != "com.tungsten.pluginstore")
                    {
                        if (v.BlockedAt is null)
                        {
                            <details class="approve-box">
                                <summary class="btn small danger">@L["Block"]</summary>
                                <form method="post" asp-page-handler="Block" asp-route-id="@pkg.Id" class="stack" style="max-width:none;margin-top:8px"
                                      data-confirm="@L["Block this version? It is withdrawn, and every Power PDF that has it installed asks its user to remove it."]">
                                    <input type="hidden" name="versionId" value="@v.Id" />
                                    <input name="reason" required minlength="3" maxlength="300" placeholder="@L["Reason (users see it)"]" />
                                    <button type="submit" class="btn small danger">@L["Block version"]</button>
                                </form>
                            </details>
                        }
                        else
                        {
                            <form method="post" asp-page-handler="Unblock" asp-route-id="@pkg.Id"
                                  data-confirm="@L["Lift the block? The version stays withdrawn until you restore it."]">
                                <input type="hidden" name="versionId" value="@v.Id" />
                                <button type="submit" class="btn small secondary">@L["Lift the block"]</button>
                            </form>
                        }
                    }
                    @if (VersionActionService.CanRestore(v, Model.IsAdmin))
                    {
                        <form method="post" asp-page-handler="Restore" asp-route-id="@pkg.Id">
                            <input type="hidden" name="versionId" value="@v.Id" />
                            <button type="submit" class="btn small secondary">@(VersionActionService.RestoreTarget(v) == VersionStatus.Live ? L["Restore (live)"] : L["Restore (beta)"])</button>
                        </form>
                    }
                </div>
            </td>
        </tr>
        <tr>
            <td colspan="6" style="padding-top:0">
                @if (Model.CanReview && v.Status == VersionStatus.Beta)
                {
                    <form method="post" asp-page-handler="Reject" asp-route-id="@pkg.Id" style="display:flex;gap:8px;margin:4px 0 8px;flex-wrap:wrap">
                        <input type="hidden" name="versionId" value="@v.Id" />
                        <input type="text" name="comment" placeholder="@L["Reason (sent to the submitter)"]" required style="flex:1;min-width:240px" />
                        <button type="submit" class="btn small danger">@L["Reject"]</button>
                    </form>
                }
                <partial name="_ValidationReport" model="AddonStore.Web.Validation.ReportView.Parse(v.ValidationReportJson)" />
                @if (Model.CanReview && (Model.AiReviewOn || v.AiReviewJson is not null) && v.PackageId != "com.tungsten.pluginstore")
                {
                    <partial name="_AiReview" model="(v, Model.AiReviewOn)" />
                }
                @if (Model.SourcePolicy != "off" || v.SourcePath is not null)
                {
                    <div class="source-row">
                        <b>@L["Source code"]:</b>
                        @if (v.SourcePath is not null)
                        {
                            <span class="badge live">@L["stored"]</span>
                            <span style="color:var(--tun-slate);font-size:.85rem">@(v.SourceSizeBytes / 1024) KB · @Time.Fmt(v.SourceUploadedAt) · @v.SourceUploadedBy</span>
                            @if (Model.IsAdmin)
                            {
                                <a class="btn small secondary" href="/api/packages/@v.PackageId/@v.Version/source">@L["Download source"]</a>
                            }
                        }
                        else
                        {
                            <span class="badge @(Model.SourcePolicy == "required" && v.PackageId != "com.tungsten.pluginstore" ? "rejected" : "withdrawn")">@L["missing"]</span>
                            @if (Model.SourcePolicy == "required" && v.Status == VersionStatus.Beta && v.PackageId != "com.tungsten.pluginstore")
                            {
                                <span style="color:var(--tun-slate);font-size:.85rem">@L["Required before approval."]</span>
                            }
                        }
                        @if ((Model.IsOwner || Model.IsAdmin) && v.Status is not (VersionStatus.Rejected or VersionStatus.Withdrawn))
                        {
                            <form method="post" asp-page-handler="Source" asp-route-id="@pkg.Id" enctype="multipart/form-data" class="source-upload">
                                <input type="hidden" name="versionId" value="@v.Id" />
                                <input type="file" name="source" accept=".zip" required />
                                <button type="submit" class="btn small secondary">@L[v.SourcePath is null ? "Upload source (ZIP)" : "Replace source"]</button>
                            </form>
                        }
                    </div>
                }
            </td>
        </tr>
    }
</table>
</div>
<partial name="_Pager" model='new AddonStore.Web.Services.PagerModel("versions", Model.Versions.Count)' />

@{
    var ratingTotal = Model.RatingDist.Sum();
    var ratingAvg = ratingTotal == 0 ? 0 : Enumerable.Range(1, 5).Sum(i => i * Model.RatingDist[i - 1]) / (double)ratingTotal;
}
<h2>@L["Ratings and feedback"]</h2>
<div class="grid">
    <div class="card">
        <h3 style="margin-top:0">@L["Ratings"]</h3>
        @if (ratingTotal == 0)
        {
            <p class="muted">@L["No ratings yet. Users rate add-ons in the store window inside Power PDF."]</p>
        }
        else
        {
            <partial name="_Stars" model="(Math.Round(ratingAvg, 1), ratingTotal)" />
            @for (var st = 5; st >= 1; st--)
            {
                var n = Model.RatingDist[st - 1];
                <div class="share"><span>@st ★</span><span class="track"><i style="width:@((100.0 * n / ratingTotal).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture))%"></i></span><span>@n</span></div>
            }
        }
    </div>
</div>
@if (Model.IsOwner || Model.IsAdmin)
{
    <div class="card">
        <h3 style="margin-top:0" id="feedback">@L["Problem reports and comments"]</h3>
        <p class="muted small">@L["Sent from the store window inside Power PDF. Only you and the admins see them; your AI assistant reads them via GET /api/packages/<id>/feedback."]
            <a href="/Issues?pkg=@Uri.EscapeDataString(Model.Pkg!.Id)&amp;view=all">@L["Open in the problem report queue"] →</a></p>
        @if (Model.Feedbacks.Count == 0)
        {
            <p class="muted">@L["Nothing received yet."]</p>
        }
        else
        {
            <div class="table-wrap">
            <table>
                <tr><th>@L["Received"]</th><th>@L["Type"]</th><th>@L["Version"]</th><th>@L["Message"]</th><th>@L["Status"]</th></tr>
                @foreach (var f in AddonStore.Web.Services.Paging.Items(Model.Feedbacks, ViewContext.HttpContext.Request, "feedback"))
                {
                    <tr>
                        <td class="small">@Time.Fmt(f.CreatedAt)@if (f.Country != "") { <br /><span class="muted">@f.Country</span> }</td>
                        <td><span class="badge @(f.Kind == "problem" ? "rejected" : "submitted")">@L[f.Kind == "problem" ? "Problem" : "Comment"]</span></td>
                        <td>@f.Version</td>
                        <td style="white-space:pre-wrap;max-width:520px">@f.Message
                            @if (!string.IsNullOrEmpty(f.Email)) { <div class="small"><a href="mailto:@f.Email">@f.Email</a></div> }
                            <div class="small muted">@f.ClientInfo</div>
                            @if (f.AiAt is not null)
                            {
                                var de = AddonStore.Web.Services.Lang.Current == "de";
                                <div class="ai-box small" style="white-space:normal">
                                    <div class="ai-head">
                                        <b>@L["AI assessment"]</b>
                                        <span class="badge submitted">@L[f.AiCategory switch { "bug" => "Bug", "wish" => "Wish", "question" => "Question", "praise" => "Praise", _ => "Other" }]</span>
                                        <span class="badge @(f.AiSeverity == "high" ? "rejected" : f.AiSeverity == "medium" ? "pending" : "withdrawn")">@L[f.AiSeverity == "high" ? "high" : f.AiSeverity == "medium" ? "medium" : "low"]</span>
                                        @if (f.AiDuplicateOf is not null) { <span class="muted">@L["Similar to report #{0}", f.AiDuplicateOf]</span> }
                                    </div>
                                    <div>@(de ? f.AiSummaryDe : f.AiSummaryEn)</div>
                                    @if (!string.IsNullOrEmpty(f.AiReply))
                                    {
                                        <details><summary>@L["Suggested reply"]</summary><pre class="code" style="white-space:pre-wrap">@f.AiReply</pre></details>
                                    }
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(f.LogExcerpt))
                            {
                                <details class="small"><summary>@L["Log excerpt"]</summary><pre class="code" style="max-height:260px;overflow:auto">@f.LogExcerpt</pre></details>
                            }
                        </td>
                        <td>
                            <span class="badge cap @AddonStore.Web.Services.IssueService.Badge(f.Status)">@L[AddonStore.Web.Services.IssueService.Label(f.Status)]</span>
                            <div style="margin-top:6px"><a class="btn small secondary" href="/Issues/@f.Id">#@f.Id @L["Details"]</a></div>
                        </td>
                    </tr>
                }
            </table>
            </div>
            <partial name="_Pager" model='new AddonStore.Web.Services.PagerModel("feedback", Model.Feedbacks.Count)' />
        }
    </div>
}
